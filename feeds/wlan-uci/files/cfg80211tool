#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

if [ -f /lib/wifi_mcc/qcacld32-utils.sh ]; then
	. /lib/wifi_mcc/qcacld32-utils.sh
else
	. /lib/wifi/qcacld32-utils.sh
fi

wlandev_prefix="wifi"

usage() {
cat <<EOF
Usage: $0
cfg80211tool [device|interface] [command] [value]
EOF

exit 1
}

__scan_wifi() {
	local cfgfile="$1"
	DEVICES=
	config_load "${cfgfile:-wireless}"

	# Create a virtual interface list field for each wifi-device
	#
	# input: $1 section: section name of each wifi-device
	create_vifs_list() {
		local section="$1"
		append DEVICES "$section"
		config_set "$section" vifs ""
	}
	config_foreach create_vifs_list wifi-device

	# Append each wifi-iface to the virtual interface list of its associated wifi-device
	#
	# input: $1 section: section name of each wifi-iface
	append_vif() {
		local section="$1"
		config_get scan_device "$section" device
		config_get vifs "$scan_device" vifs
		append vifs "$section"
		config_set "$scan_device" vifs "$vifs"
		# For wifi-iface (VAP), record its index and section name in variable
		# vifname_#. This will be used later when generating wsplcd config file
		# to match the VAP with correct index.
		eval "vifname_${TOTAL_NUM_VIFS}=$section"
		TOTAL_NUM_VIFS=$(($TOTAL_NUM_VIFS + 1))
	}
	config_foreach append_vif wifi-iface
}

wlan_g_oper_reg_info() {
	local device=$1
	local iface=""
	local band

	# Set default values
	case $device in
		${wlandev_prefix}0)
			iface="wlan0"
			if [ $owrt_build -eq 1 ]; then
				band="5"
			else
				band="2.4"
			fi
			;;
		${wlandev_prefix}1)
			iface="wlan2"
			if [ $owrt_build -eq 1 ]; then
				band="2.4"
			else
				band="5"
			fi
			;;
		*)
			return 255
			;;
	esac

	__scan_wifi

	config_get vifs "$device" vifs
	for vif in $vifs; do
		config_get_bool disabled "$vif" disabled 0
		[ $disabled -eq 1 ] && continue

		config_get vif_device "$vif" device
		config_get vif_ifname "$vif" ifname
		if [ ! -z $vif_ifname ] && [ "$vif_device" = "$device" ]; then
			iface=$vif_ifname
			break
		fi
	done

	# check if interface exists
	if [ ! -e /sys/class/net/${iface} ]; then
		echo "$1   $2:chan=, freq=, band=${band}GHz, chwidth="
		return 0
	fi

	reg_info="$(iw dev ${iface} info | grep channel)" 2> /dev/null
	if [ -z "$reg_info" ]; then
		echo "$1   $2:chan=, freq=, band=${band}GHz, chwidth="
		return 0
	else
		chan=$(echo $reg_info | awk -F ' ' '{print $2}')
		freq=$(echo $reg_info | awk -F 'center1: ' '{print $2}' | awk -F ' MHz' '{print $1}')
		if [ ! -z $freq ]; then
			if [ $freq -gt 4000 ] && [ $freq -lt 5895 ]; then
				band="5"
			elif [ $freq -ge 5895 ]; then
				band="6"
			else
				band="2.4"
			fi
		fi
		chwidth=$(echo $reg_info | awk -F 'width: ' '{print $2}' | awk -F ' MHz' '{print $1}')

		echo "$1   $2:chan=$chan, freq=${freq}MHz, band=${band}GHz, chwidth=${chwidth}MHz"
		return 0
	fi
}

wlan_get_opmode() {
	[ ! -e /sys/class/net/$1 ] && return 255

	type_info="$(iw dev ${1} info | grep type)" 2> /dev/null
	if [ -z "$type_info" ]; then
		return 255
	else
		type=$(echo $type_info | awk -F ' ' '{print $2}')
		case $type in
			AP) type_str=HOSTAP;;
			managed) type_str=STA;;
			*) return 255;;
		esac
		echo "$1   $2:$type_str"
		return 0
	fi
}

wlan_mesh_get_MapBSSType_from_wireless() {
	local MapBSSType=$(uci get wireless.$1.MapBSSType)
	echo "$1   $2:$MapBSSType"
	return 0

	local device vifs vif ifname

	__scan_wifi

	for device in $DEVICES; do
		config_get_bool disabled "$device" disabled 0
		[ $disabled -eq 1 ] && continue

		config_get vifs "$device" vifs
		for vif in $vifs; do
			config_get_bool disabled "$vif" disabled 0
			[ $disabled -eq 1 ] && continue

			config_get MapBSSType "$vif" MapBSSType 0
			config_get ifname "$vif" ifname
			if [ "$ifname" = "$1" ]; then
				echo "$1   $2:$MapBSSType"
				return 0
			fi
		done
	done
}

cfg80211tool_command() {
	case "$0" in
		/usr/sbin/cfg80211tool) cfg80211tool_command_vap "$@";;
		/usr/sbin/cfg80211tool_mesh) cfg80211tool_mesh_command "$@";;
		*) ;;
	esac
}

cfg80211tool_mesh_command() {
	xml_path="/etc/misc/wifi/qcacommands_mesh.xml"
	cfg80211tool_call "$@"
}

cfg80211tool_command_vap() {
	xml_path="/etc/misc/wifi/qcacommands_vap.xml"
	cfg80211tool_call "$@"
}

cfg80211tool_call() {
	if [ -z "$3" ]; then
		val=0
	else
		val=$3
	fi

	if [ "$#" -eq 1 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h list
	fi
	if [ "$#" -eq 2 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 3 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 4 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 5 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 6 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --value3 $6 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 7 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --value3 $6 --value4 $7 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 8 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --value3 $6 --value4 $7 --value5 $8 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 9 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --value3 $6 --value4 $7 --value5 $8 --value6 $9 --RESPONSE --$2 --END_CMD || return 255
	fi
	if [ "$#" -eq 10 ] && [ -n "$xml_path" ] ; then
		cfg80211tool.1 -i $1 -f $xml_path -h none --START_CMD --$2 --value0 $val --value1 $4 --value2 $5 --value3 $6 --value4 $7 --value5 $8 --value6 $9 --value7 $10 --RESPONSE --$2 --END_CMD || return 255
	fi
}

case "$2" in
	g_oper_reg_info) wlan_g_oper_reg_info "$@";;
	get_opmode) wlan_get_opmode "$@";;
	get_MapBSSType)
		if [ $owrt_build -eq 1 ]; then
			cfg80211tool_command "$@"
		else
			wlan_mesh_get_MapBSSType_from_wireless "$@"
		fi
	;;
	get_MapBSSType_command) cfg80211tool_command $1 "get_MapBSSType";;
	get_MapBSSType_wireless | get_monrxfilter) wlan_mesh_get_MapBSSType_from_wireless "$@";;
	*) cfg80211tool_command "$@";;
	--help|help) usage;;
esac
