config wifi-device wifiX
	option type      qcacld32
	option hwmode    11axg
	# REMOVE THIS LINE TO ENABLE WIFI:
	option disabled  1

config wifi-iface wifiX_AP1
	option device     wifiX
	option network    lan
	option mode       ap
	option ssid       QSoftAP_2G
	option encryption psk2+ccmp
	option key        1234567890
	option disabled   1

config wifi-iface wifiX_AP2
	option device     wifiX
	option network    lan
	option mode       ap
	option ssid       QSoftAP_2G_2
	option encryption psk2+ccmp
	option key        1234567890
	option disabled   1

config wifi-iface wifiX_STA
	option device     wifiX
	option network    wan
	option mode       sta
	option wds        1
	option extap      1
	option encryption psk2+ccmp
	option ssid       QSoftAP_2G
	option key        1234567890
	option disabled   1
