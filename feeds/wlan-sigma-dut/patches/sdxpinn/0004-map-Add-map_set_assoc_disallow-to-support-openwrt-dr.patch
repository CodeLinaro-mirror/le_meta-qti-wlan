-				ath_set_assoc_disallow(dut, WLANIF"0", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"0", "Disable");
 			if (sigma_radio_ifname[radio_id[0]] && strcmp(sigma_radio_ifname[radio_id[0]], "wifi1") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"1", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"1", "Disable");
 			if (sigma_radio_ifname[radio_id[0]] && strcmp(sigma_radio_ifname[radio_id[0]], "wifi2") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"2", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"2", "Disable");
 
 			if (sigma_radio_ifname[radio_id[1]] && strcmp(sigma_radio_ifname[radio_id[1]], "wifi0") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"0", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"0", "Disable");
 			if (sigma_radio_ifname[radio_id[1]] && strcmp(sigma_radio_ifname[radio_id[1]], "wifi1") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"1", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"1", "Disable");
 			if (sigma_radio_ifname[radio_id[1]] && strcmp(sigma_radio_ifname[radio_id[1]], "wifi2") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"2", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"2", "Disable");
 
 			if (sigma_radio_ifname[radio_id[2]] && strcmp(sigma_radio_ifname[radio_id[2]], "wifi0") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"0", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"0", "Disable");
 			if (sigma_radio_ifname[radio_id[2]] && strcmp(sigma_radio_ifname[radio_id[2]], "wifi1") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"1", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"1", "Disable");
 			if (sigma_radio_ifname[radio_id[2]] && strcmp(sigma_radio_ifname[radio_id[2]], "wifi2") == 0)
-				ath_set_assoc_disallow(dut, WLANIF"2", "Disable");
+				map_set_assoc_disallow(dut, WLANIF"2", "Disable");
 
 			map_disable_lan(dut);
 			// run_system_wrapper(dut, "ifconfig eth1 down");
@@ -5753,7 +5778,7 @@ static int cmd_dev_set_rfeature(struct sigma_dut *dut, struct sigma_conn *conn,
 
 	val = get_param(cmd, "Assoc_Disallow");
 	if (val) {
-		ath_set_assoc_disallow(dut, ifname, val);
+		map_set_assoc_disallow(dut, ifname, val);
 		goto map_set_rfeature_ok;
 	}
 
