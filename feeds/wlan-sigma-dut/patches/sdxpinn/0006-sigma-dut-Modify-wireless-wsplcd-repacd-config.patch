 {
 	int i;
+
+	printf("qcdbg, enter get_param2, name: %s\n", name);
+
 	for (i = 0; i < cmd->count; i++) {
+		printf("qcdbg, name:%s, cmd->params[%d]=%s, cmd->values[%d]=%s\n",
+			name, i, cmd->params[i], i, ((!cmd->values[i]) ? "NULL" : cmd->values[i]));
 		if (strcasecmp(name, cmd->params[i]) == 0) {
 			*ndx = i;
+			printf("qcdbg, exit get_param2, find name: %s, *ndx=%d\n", name, i);
 			return cmd->values[i];
 		}
 	}
+	printf("qcdbg, exit get_param2, failed to find name: %s\n", name);
 	*ndx = -1;
 	return NULL;
