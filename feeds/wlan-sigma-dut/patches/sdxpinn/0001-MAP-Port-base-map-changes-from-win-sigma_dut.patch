+
+	memset(&ifr, 0, sizeof(ifr));
+	strlcpy(ifr.ifr_name, ifname_temp, sizeof(ifr.ifr_name)); // check
+	if (ioctl(s, SIOCGIFHWADDR, &ifr) < 0) {
+		perror("ioctl");
+		close(s);
+		return rc;
+	}
+	close(s);
+
+	if (memcmp(map_mac, ifr.ifr_hwaddr.sa_data, (size_t)ETH_ALEN) == 0)
+		rc = true;
+	return rc;
