+static int prsna2x(struct sigma_dut *dut, const char *arg, const size_t arglen,
+		   unsigned char *value)
+{
+	int res;
+	const char *pos = arg;
+
+	if ((*(pos + 1) == 'x') || (*(pos + 1) == 'X')) {
+		pos += 2;
+	} else {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"MAP: prsna2x - Invalid value:"
+				" %s (expected format 0xyyyyy...)",
+				arg);
+		return -1;
+	}
+
+	if (strlen(pos) != 2 * arglen) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"MAP: prsna2x - Invalid argument"
+				" length: %d",
+				(int)arglen);
+		return -1;
+	}
+
+	res = parse_hexstr(pos, value, arglen);
+
+	if (res < 0 || (size_t)res >= arglen + 1) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"MAP: prsna2x - Parse hexstr"
+				" failed: %d",
+				(int)res);
+		return -2;
+	}
+	value[res] = '\0';
+
+	return 0;
+}
+
+static int map_waitup2(struct sigma_dut *dut, const int tmax,
+		       const int tinterval,
+		       bool (*workfcn)(struct sigma_dut *dut))
+{
+	int mininterval = 10, tcurr, tend, twait, i = 0;
+	bool t1sttwait = true;
+
+	dut->map_all_onboard = false;
+	sleep(2 * mininterval);
+
+	if (tmax < mininterval || tinterval < mininterval)
+		return -1;
+
+	if (!workfcn)
+		tcurr = twait = tmax;
+	else
+		tcurr = twait = 3 * tinterval;
+
+	tend = tmax + tinterval;
+
+	while ((tcurr % tend) != 0) {
+		sleep(twait);
+		if (workfcn) {
+			if (workfcn(dut)) {
+				if (i++ > 2 || dut->map_all_onboard)
+					break;
+			}
+		}
+		tcurr += tinterval;
+
+		if (t1sttwait) {
+			twait = tinterval;
+			t1sttwait = false;
+		}
+	}
+
+	return ((tcurr == tend) ? tmax : tcurr);
+}
