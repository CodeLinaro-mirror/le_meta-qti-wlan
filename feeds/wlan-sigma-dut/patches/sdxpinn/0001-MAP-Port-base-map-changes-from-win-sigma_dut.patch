+static int map_send_dpp_bootstrapping_data(struct sigma_dut *dut, struct sigma_conn *conn, const char *macaddr, int dpp_cmd)
+{
+	char buf[3000] = {0};
+	char temp_addr[ETH_ALEN] = {0};
+	char *temp_mac = "0x000000000000";
+	char *pw = buf;
+	char alid [16];
+	char len[8];
+	char type[8];
+	char msg[8];
+
+	strlcpy(dut->map_msgtypeval, (char *)&temp_mac[2], 4);
+	if (macaddr)
+		strlcpy(pw, macaddr, sizeof(buf));
+	else {
+		parse_mac_address(dut, temp_mac , (unsigned char *)temp_addr);
+		snprintf(pw, 14, "%02x%02x%02x%02x%02x%02x ",
+			 temp_addr[0], temp_addr[1],
+			 temp_addr[2], temp_addr[3],
+			 temp_addr[4], temp_addr[5]);
+	}
+	pw += 13;
+
+	snprintf(pw, 4, "%02x ", (unsigned char)dpp_cmd);
+	pw += 3;
+
+	if (dpp_cmd == MAP_DPP_PEER_BOOTSTRAP_DATA && dut->dpp_peer_uri) {
+		char OnboardingType[512];
+		FILE *fp1;
+
+		fp1 = popen("cat /etc/config/repacd | grep  OnboardingType", "r");
+		if (!fp1) {
+			sigma_dut_print(dut, DUT_MSG_ERROR, "Failed to get onboarding type from repacd.init");
+			return -1;
+		}
+
+		fgets(OnboardingType, sizeof(OnboardingType), fp1);
+		pclose(fp1);
+
+		if (strstr(OnboardingType, "dpp") == NULL) {
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.OnboardingType=dpp");
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.MapDevResetDefault=2");
+			run_system_wrapper(dut, "uci commit repacd");
+			run_system_wrapper(dut, INIT_SCRIPT_PATH"repacd start");
+			sleep(10);
+		}
+
+		/*send peer bootstrap data */
+		 strlcpy(pw, dut->dpp_peer_uri, sizeof(buf)-16);
+
+	} else if (dpp_cmd == MAP_DPP_LOCAL_BOOTSTRAP_DATA) {
+		/* Send  local bootstrap data */
+		strlcpy(pw, dut->map_local_bootstrapping_data, sizeof(buf)-16);
+
+	} else {
+		return -1;
+	}
+
+	snprintf(type, sizeof(type), "%02x", (unsigned char)dpp_cmd);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+				"MAP-dpp-bpd type: %s",
+				type);
+
+	snprintf(len, sizeof(len), "%04x", (uint16_t)(strlen(buf)-16));
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+				"MAP-dpp-bpd data len: %s",
+				len);
+	snprintf(msg, sizeof(len), "%04x", (uint16_t)dpp_cmd);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+				"MAP-dpp-bpd msg: %s",
+				msg);
+
+	snprintf(alid, sizeof(alid), "%02x%02x%02x%02x%02x%02x",
+			temp_addr[0], temp_addr[1],
+			temp_addr[2], temp_addr[3],
+			temp_addr[4], temp_addr[5]);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+				"MAP-dpp-bpd alid: %s",
+				alid);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+				"MAP-dpp-bpd local value: %s",
+				buf);
+
+	if (map_test_socket(dut, conn, type, alid, msg, len,
+				buf) < 0)
+		return -1;
+
+	return 1;
+}
