+static int map_parse_link_metric_query_tlv(struct sigma_dut *dut,
+					   const char *mod, char *buf,
+					   size_t bufsize)
+{
+	/* tlvtype = 0x08 */
+	char token[4096], *token_p, *saveptr;
+	unsigned char naddr[6];
+	int q;
+	int value;
+	char *pw = buf;
+
+	memset(buf, 0, bufsize);
+
+	for (q = 0; q < ETH_ALEN; q++)
+		naddr[q] = 0xFF;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	/* Neighbor Flag 00=All, 01=specific, rest rsvd  */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: Neighbor Flag = %02x",
+			(unsigned char)value);
+
+	if (value == 1) {
+		/* MAC address for Neighbor */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, naddr) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x", naddr[0],
+			 naddr[1], naddr[2], naddr[3], naddr[4], naddr[5]);
+	} else if (value == 0) { /* All 0xFF Mac address for neighbor */
+		snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x", naddr[0],
+			 naddr[1], naddr[2], naddr[3], naddr[4], naddr[5]);
+	} else {
+		return -1;
+	}
+
+	/* Link Metrics requested  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+			"MAP: Link Metrics requested = %02x",
+			(unsigned char)value);
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
+
+static int map_parse_channel_preference_tlv(struct sigma_dut *dut,
+					    const char *mod, char *buf,
+					    size_t bufsize)
+{
+	/* tlvtype = 0x8B */
+	unsigned char map_ruid[6];
+	char token[4096], *token_p, *saveptr;
+	int value;
+	char *pr;
+
+	dut->map_pw = buf;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0x8b;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* RUID */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if (parse_mac_address(dut, token_p, map_ruid) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_ruid[0],
+		 map_ruid[1], map_ruid[2], map_ruid[3], map_ruid[4],
+		 map_ruid[5]);
+	dut->map_pw += 13;
+
+	while ((token_p = strtok_r(NULL, " ", &saveptr)) != NULL) {
+		pr = token_p + 1;
+		if (*pr == 'x') {
+			value = hex_byte(++pr);
+		} else if (*pr == 'd') {
+			value = decimal_byte(++pr);
+		} else if (*pr == 'b') {
+			int tempval = 0;
+			tempval = binary_byte(++pr);
+			if (strlen(token_p) != 6) {
+				value = tempval;
+			} else {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				pr = token_p + 1;
+				value = (tempval << 4) | binary_byte(++pr);
+			}
+		}
+
+		if (value < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return 1;
+}
