+const char *get_param2(struct sigma_cmd *cmd, const char *name, int *ndx)
+{
+	int i;
+	for (i = 0; i < cmd->count; i++) {
+		if (strcasecmp(name, cmd->params[i]) == 0) {
+			*ndx = i;
+			return cmd->values[i];
+		}
+	}
+	*ndx = -1;
+	return NULL;
+}
+const char *map_get_param_ndx(struct sigma_cmd *cmd, const char *name,
+			      const int ndx)
+{
+	printf("\nndx=%d count=%d\n", ndx, cmd->count);
+	if (ndx < cmd->count && ndx >= 0) {
+		if (strcasecmp(name, cmd->params[ndx]) == 0)
+			return cmd->values[ndx];
+	}
+	return NULL;
+}
