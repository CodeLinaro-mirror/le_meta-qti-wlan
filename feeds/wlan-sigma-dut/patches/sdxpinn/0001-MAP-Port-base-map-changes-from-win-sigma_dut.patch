+static int map_dpp_deauth(struct sigma_dut *dut, const char *macAddr)
+{
+	struct ifaddrs *ifaddr;
+	char buf[512] = {0}, *hw_name = "";
+
+	if (getifaddrs(&ifaddr) == -1)
+		return -1;
+
+	for (struct ifaddrs *ifa = ifaddr; ifa != NULL;
+			     ifa = ifa->ifa_next) {
+		if (ifa->ifa_addr == NULL)
+			continue;
+
+		if (strstr(ifa->ifa_name, "ath")) {
+			sigma_dut_print(dut, DUT_MSG_DEBUG,"%-8s\n", ifa->ifa_name);
+			if (strstr(ifa->ifa_name, "ath2"))
+				hw_name = "wifi2";
+			else if (strstr(ifa->ifa_name, "ath1"))
+				hw_name = "wifi1";
+			else
+				hw_name = "wifi0";
+
+			snprintf(buf, sizeof(buf),
+			      "hostapd_cli -i %s -p /var/run/hostapd-%s/ deauth %s",
+				  ifa->ifa_name, hw_name, macAddr);
+			run_system_wrapper(dut, buf);
+		}
+	}
+
+	freeifaddrs(ifaddr);
+	return 1;
+}
