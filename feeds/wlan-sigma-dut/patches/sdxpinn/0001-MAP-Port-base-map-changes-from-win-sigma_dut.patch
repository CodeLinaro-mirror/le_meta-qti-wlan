+static int map_parse_default_802_1q_settings_tlv(struct sigma_dut *dut,
+						 const char *mod, char *buf,
+						 size_t bufsize)
+{
+	/* tlvtype = 0xB5 */
+	char token[4096], *token_p, *saveptr;
+	int value;
+	dut->map_pw = buf;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xB5;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Primary VLAN ID */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%04x ", (unsigned char)value);
+	dut->map_pw += 5;
+
+	/* Default PCP */
