+int cmd_dev_map_get_parameter(struct sigma_dut *dut, struct sigma_conn *conn,
+				 struct sigma_cmd *cmd)
+{
+#if defined(__linux__)
+	char resp[1024];
+	unsigned char addr[6];
+	char *if_name;
+	char ifname[16];
+	char ifname1[16];
+	struct ifreq ifr;
+	int s, rc = -1;
+	const char *val;
+	char macaddr[32];
+	char ruid[32];
+	char bssid[32];
+	int radio_id[MAX_RADIO] = {0, 1, 2};
+	int radio_count, radio_no;
+	char buf[1024];
+
+	memset(addr, 0, sizeof(addr));
+	for (radio_count = 0; radio_count < MAX_RADIO; radio_count++) {
+		snprintf(buf, sizeof(buf), "%s%d", "wifi", radio_count);
+		for (radio_no = 0; radio_no < MAX_RADIO; radio_no++) {
+			if (!sigma_radio_ifname[radio_no] ||
+			    strcmp(sigma_radio_ifname[radio_no], buf) != 0)
+				continue;
+			radio_id[radio_no] = radio_count;
+		}
+	}
+	val = get_param(cmd, "ruid");
+	if (val) {
+		strlcpy(ruid, val, sizeof(ruid));
+		if (parse_mac_address(dut, val, addr) < 0) {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,invalid ruid");
+			goto map_get_param_error;
+		}
+	}
+
+	val = get_param(cmd, "parameter");
+	if (val) {
+		if (strcasecmp(val, "bssid") == 0) {
+			val = get_param(cmd, "ssid");
+			if (val) {
+				dut->map_ifname[0] = '\0';
+				map_get_ifname_apmode(dut, val, dut->map_ifname);
+				if ((rc = map_get_bssid(dut, val, ruid, ifname1,
+							bssid)) > 0)
+					rc =
+					    parse_mac_address(dut, bssid, addr);
+			} else if ((rc = map_get_bsta_bssid(dut, bssid)) > 0) {
+				rc = parse_mac_address(dut, bssid, addr);
+			}
+
+			if (rc < 0) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "bssid, not found");
+				goto map_get_param_error;
+			} else {
+				snprintf(resp, sizeof(resp),
+					 "bssid,%02x:%02x:%02x:%02x:%02x:%02x",
+					 addr[0], addr[1], addr[2], addr[3],
+					 addr[4], addr[5]);
+				send_resp(dut, conn, SIGMA_COMPLETE, resp);
+				goto map_get_param_ok;
+			}
+
+		} else if (strcasecmp(val, "macaddr") == 0) {
+			val = get_param(cmd, "ssid");
+			if (val) {
+				dut->map_ifname[0] = '\0';
+				map_get_ifname_apmode(dut, val, dut->map_ifname);
+				if ((rc = map_get_macaddr(dut, macaddr,
+							  sizeof(macaddr), ruid,
+							  val)) > 0)
+					rc = parse_mac_address(dut, macaddr,
+							       addr);
+
+			} else if (dut->map_bh24g || dut->map_bh5g ||
+				   dut->map_bh5gh) {
+				if (num_radio == 3) {
+					if (dut->map_bh24g)
+						snprintf(ifname, sizeof(ifname),
+							 "ath%d1", radio_id[2]);
+					else if (dut->map_bh5g)
+						snprintf(ifname, sizeof(ifname),
+							 "ath%d1", radio_id[1]);
+					else
+						snprintf(ifname, sizeof(ifname),
+							 "ath%d1", radio_id[0]);
+				} else {
+					if (dut->map_bh24g)
+						snprintf(ifname, sizeof(ifname),
+							 "ath%d1", radio_id[1]);
+					else if (dut->map_bh5g)
+						snprintf(ifname, sizeof(ifname),
+							 "ath%d1", radio_id[0]);
+				}
+				s = socket(AF_INET, SOCK_DGRAM, 0);
+				if (s < 0) {
+					send_resp(
+					    dut, conn, SIGMA_ERROR,
+					    "errorCode,socket not created");
+					goto map_get_param_error;
+				}
+				memset(&ifr, 0, sizeof(ifr));
+				strlcpy(ifr.ifr_name, ifname,
+					sizeof(ifr.ifr_name));
+				if (ioctl(s, SIOCGIFHWADDR, &ifr) < 0) {
+					perror("ioctl");
+					close(s);
+					send_resp(dut, conn, SIGMA_ERROR,
+						  "errorCode,ioctl failed");
+					goto map_get_param_error;
+				}
+				close(s);
+				memcpy(addr, ifr.ifr_hwaddr.sa_data, ETH_ALEN);
+				rc = 1;
+			}
+
+			snprintf(resp, sizeof(resp),
+				 "macaddr,%02x:%02x:%02x:%02x:%02x:%02x",
+				 addr[0], addr[1], addr[2], addr[3], addr[4],
+				 addr[5]);
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_get_param_ok;
+
+		} else if (strcasecmp(val, "Alid") == 0) {
+			if_name = DEFAULT_BRIDGE;
+			s = socket(AF_INET, SOCK_DGRAM, 0);
+			if (s < 0) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,socket not created");
+				goto map_get_param_error;
+			}
+			memset(&ifr, 0, sizeof(ifr));
+			strlcpy(ifr.ifr_name, if_name, sizeof(ifr.ifr_name));
+			if (ioctl(s, SIOCGIFHWADDR, &ifr) < 0) {
+				perror("ioctl");
+				close(s);
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,ioctl failed");
+				goto map_get_param_error;
+			}
+			close(s);
+
+			snprintf(resp, sizeof(resp),
+				 "Alid,%02x:%02x:%02x:%02x:%02x:%02x",
+				 ifr.ifr_hwaddr.sa_data[0],
+				 ifr.ifr_hwaddr.sa_data[1],
+				 ifr.ifr_hwaddr.sa_data[2],
+				 ifr.ifr_hwaddr.sa_data[3],
+				 ifr.ifr_hwaddr.sa_data[4],
+				 ifr.ifr_hwaddr.sa_data[5]);
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_get_param_ok;
+		} else if (strcasecmp(val, "passphrase") == 0) {
+			memcpy(resp, "passphrase,", 11);
+			int i, c, count = 0;
+			FILE *fp = fopen("/tmp/ptk.txt", "r");
+			if(fp) {
+				while ((c = fgetc(fp)) != EOF) {
+					if((char) c == '_') count++;
+				}
+				for(i=0;i<count;i++) memcpy(&resp[11+i*10], "maprocks2_", 10);
+				resp[11+i*10-1] = '\0';
+				send_resp(dut, conn, SIGMA_COMPLETE, resp);
+				goto map_get_param_ok;
+			}
+			else {
+				send_resp(dut, conn, SIGMA_ERROR,"Cannot find /tmp/ptk.txt");
+				goto map_get_param_error;
+			}
+		} else if (strcasecmp(val, "PMK") == 0) {
+			val = get_param(cmd, "STA_MACAddress");
+			if (!val)
+				goto map_get_param_error;
+			memset(resp,0,sizeof(resp));
+			memcpy(resp, "PMK,", 4);
+			resp[4] = '\0';
+			FILE *fp;
+			fp = fopen("/tmp/pmk.txt", "r");
+			if(fp) {
+				fscanf(fp, "%s", &resp[4]);
+				resp[strlen(resp)-1] = '\0';
+				fclose(fp);
+			} else {
+				send_resp(dut, conn, SIGMA_ERROR,"Cannot find /tmp/pmk.txt");
+				goto map_get_param_error;
+			}
+	   		send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_get_param_ok;
+		} else if (strcasecmp(val, "PTK") == 0) {
+			val = get_param(cmd, "STA_MACAddress");
+			if (!val)
+				goto map_get_param_error;
+	   //str*cat(cmd, val); //snprintf(ifname, sizeof(ifname), "ath12");  /*to fix*/
+			memset(resp, 0, sizeof(resp));
+			memcpy(resp, "PTK,", 4);
+			resp[4] = '\0';
+			FILE *fp;
+			fp = fopen("/tmp/ptk.txt", "r");
+			if(fp) {
+				fscanf(fp, "%s", &resp[4]);
+				resp[strlen(resp)-1] = '\0';
+				fclose(fp);
+			} else {
+				send_resp(dut, conn, SIGMA_ERROR,"Cannot find /tmp/ptk.txt");
+				goto map_get_param_error;
+			}
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_get_param_ok;
+		}
+	}
+
+	send_resp(dut, conn, SIGMA_ERROR,
+		  "errorCode,dev_get_parameter invalid ");
+
+map_get_param_error:
+	return -1;
+
+map_get_param_ok:
+	return 0;
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		  "errorCode,dev_get_parameter not supported");
+	return -1;
+#endif /* __linux__ */
+}
