+						 "NonRelayingEthernetInterface="
+						 "ath21");
+					run_system_wrapper(
+					    dut, INIT_SCRIPT_PATH"mcsd stop");
+					run_system_wrapper(
+					    dut, INIT_SCRIPT_PATH"mcsd disable");
+					run_system_wrapper(
+					    dut, "uci set"
+						 " ezmesh.config.Enable=1");
+					run_system_wrapper(dut, "uci set "
+								"wsplcd.config."
+								"HyFiSecurity="
+								"1");
+					run_system_wrapper(dut, "uci set"
+						" repacd.MAPConfig.MapBackaulType=wifi");
+					if (dut->map_device_role == MAP_DEVROLE_AGENT)
+						run_system_wrapper(dut, "uci set"
+							" repacd.MAPConfig."
+							"MapDevResetDefault=0");
+					run_system_wrapper(dut, "uci commit");
+					run_system_wrapper(
+					    dut,
+					    INIT_SCRIPT_PATH"hyfi-bridging start");
+
+					if (dut->program == PROGRAM_MAP ||
+					    dut->program == PROGRAM_MAPR2 ||
+											dut->program == PROGRAM_MAPR3 ||
+											dut->program == PROGRAM_MAPR4 ||
+											dut->program == PROGRAM_MAPR5)
+						run_system_wrapper(dut,
+							INIT_SCRIPT_PATH"repacd start");
+					else
+						run_system_wrapper(dut, "wifi");
+
+					sleep(4);
+					run_system_wrapper(dut,
+							   "brctl setageing "
+							   DEFAULT_BRIDGE" 10");
+					if (typeval && strcasecmp(typeval, "dpp") == 0 ) {
+						sleep(30);
+						if (map_send_dpp_bootstrapping_data(dut, conn, ruid, MAP_DPP_LOCAL_BOOTSTRAP_DATA) < 0) {
+							send_resp(dut, conn, SIGMA_ERROR,
+								"errorCode,dpp bootstraping failed");
+							goto map_set_config_error;
+						}
+					}
+			} else {
+				send_resp(dut, conn, SIGMA_ERROR,
+						"errorCode,Unsupported "
+						"backhaul type");
+				goto map_set_config_error;
+			}
+		}
+	} else {
+		send_resp(dut, conn, SIGMA_ERROR,
+			  "errorCode,Unsupported configuration parameter");
+		goto map_set_config_error;
+	}
+
+map_set_config_ok:
+	return 1;
+
+map_set_config_error:
+	return -1;
+
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		  "errorCode,dev_set_config not supported");
+	return -1;
+#endif /* __linux__ */
+}
