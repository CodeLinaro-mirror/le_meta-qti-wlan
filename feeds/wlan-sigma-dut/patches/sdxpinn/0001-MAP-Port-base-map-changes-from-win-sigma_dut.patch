+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* BSSID Field */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if (parse_mac_address(dut, token_p, map_bssid) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_bssid[0],
+		 map_bssid[1], map_bssid[2], map_bssid[3], map_bssid[4],
+		 map_bssid[5]);
+	pw += 13;
+
+	/* Reporting Detail Field */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((reporting_detail = value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* SSID Length - g */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((g = get_value(token_p)) < 0)
+		return -1;
+
+	snprintf(pw, bufsize, "%02x ", (unsigned char)g);
+	pw += 3;
+
+	/* SSID */
+	if (g > 0) {
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if ((!token_p) || (g != strlen(token_p)) ||
+		    (g > (sizeof(buf) - strlen(buf))))
+			return -1;
+
+		strlcpy(pw, token_p, g + 1);
+
+		pw[g] = 0x20; /* space */
+		pw += (g + 1);
+	}
+
+	/* Number of AP Channel Reports - h */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((h = get_value(token_p)) < 0)
+		return -1;
+	if (channum != 255)
+		h = 0;
+
+	snprintf(pw, bufsize, "%02x ", (unsigned char)h);
+	pw += 3;
+
+	for (i = 0; i < h; i++) {
+
+		/* Length of an AP Channel Report - k */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+
+		if ((k = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)k);
+		pw += 3;
+
+		/* Operating Class in an AP Channel Report */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+
+		/* Channel List - k-1*/
+		for (j = 0; j < k - 1; j++) {
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+		} /* k loop */
+	}	 /* h loop */
+
+	/* Number of Element IDs - m */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((m = get_value(token_p)) < 0)
+		return -1;
+	if (reporting_detail != 1)
+		m = 0;
+
+	snprintf(pw, bufsize, "%02x ", (unsigned char)m);
+	pw += 3;
+
+	for (i = 0; i < m; i++) {
+		/* Element list - m-1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+	} /* m loop */
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
