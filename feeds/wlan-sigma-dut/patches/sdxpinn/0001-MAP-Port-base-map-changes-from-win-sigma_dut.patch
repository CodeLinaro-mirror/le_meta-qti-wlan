+
+static int map_parse_tlvvalue(struct sigma_dut *dut, char *mod, char *buf,
+			      size_t bufsize, int one_tlv)
+{
+	char token[4096], *saveptr;
+	char ic[3];
+	char *bssid = NULL;
+	char *sta_mac = NULL;
+	int vlan_id;
+
+	switch (dut->map_tlvtype) {
+	case IEEE1905_TLV_TYPE_AL_ID:
+		if (map_parse_al_mac_address_type_tlv(dut, mod, dut->map_pw,
+						      bufsize) < 1) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"MAP: parsing 1905_tlv AL_ID failed");
+			goto map_parse_tlvvalue_error;
+		}
+		dut->map_multi_tlv = true;
+
+		if (one_tlv == 1) {
+			dut->map_multi_tlv = false;
+			snprintf(ic, sizeof(ic), "%02x ",
+				 (unsigned char)dut->map_tlvcnt);
+			buf[0] = ic[0];
+			buf[1] = ic[1];
+			strlcpy(dut->map_tlvvalue, buf,
+				sizeof(dut->map_tlvvalue));
+		}
+
+		break;
+
+	case IEEE1905_TLV_TYPE_LOOP_PREVENTION_MECHANISM:
+		if (map_parse_loop_prevent_mechanism_tlv(dut, mod, dut->map_pw,
+							bufsize) < 1) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"MAP: parsing 1905_tlv loop prevention failed");
+			goto map_parse_tlvvalue_error;
+		}
+
+		dut->map_multi_tlv = true;
+
+		if (one_tlv == 1) {
+			dut->map_multi_tlv = false;
+			snprintf(ic, sizeof(ic), "%02x ",
+				(unsigned char)dut->map_tlvcnt);
+			buf[0] = ic[0];
+			buf[1] = ic[1];
+			strlcpy(dut->map_tlvvalue, buf,
+				sizeof(dut->map_tlvvalue));
+		}
+
+		break;
+
+	case IEEE1905_TLV_TYPE_LOOP_DETECTION_SEQ_NUMBER:
+		if (map_parse_loop_detection_seqnum_tlv(dut, mod, dut->map_pw,
+							bufsize) < 1) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"MAP: parsing 1905_tlv loop detection failed");
+			goto map_parse_tlvvalue_error;
+		}
+
+		dut->map_multi_tlv = true;
+
+		if (one_tlv == 1) {
+			dut->map_multi_tlv = false;
+			snprintf(ic, sizeof(ic), "%02x ",
+				(unsigned char)dut->map_tlvcnt);
+			buf[0] = ic[0];
+			buf[1] = ic[1];
+			strlcpy(dut->map_tlvvalue, buf,
+				sizeof(dut->map_tlvvalue));
+		}
+
+		break;
+
+	case IEEE1905_TLV_TYPE_SPATIAL_REUSE_REQUEST:
+		if (map_parse_spatial_reuse_request_tlv(dut, mod, dut->map_pw,
+							bufsize) < 1) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"MAP: parsing 1905_tlv spatial reuse request failed");
+			goto map_parse_tlvvalue_error;
+		}
+
+		dut->map_multi_tlv = true;
+
+		if (one_tlv == 1) {
+			dut->map_multi_tlv = false;
+			snprintf(ic, sizeof(ic), "%02x ",
+				(unsigned char)dut->map_tlvcnt);
