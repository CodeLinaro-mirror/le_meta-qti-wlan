+static int map_parse_channel_scan_request_tlv(struct sigma_dut *dut,
+					      const char *mod, char *buf,
+					      size_t bufsize)
+{
+	/* tlvtype = 0xA6 */
+	char token[4096], *token_p, *saveptr, val[32];
+	int value, j, r, m, k, i, q;
+	char *pw = buf;
+
+	memset(buf, 0, bufsize);
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	/* Scan indicator */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* Number of radios r  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((r = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)r);
+	pw += 3;
+
+	if (r < 1)
+		return -1;
+	for (i = 0; i < r; i++) {
+		/* Radio identifier */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (prsna2x(dut, token_p, (size_t)6, (unsigned char *)val) < 0)
+			return -1;
+
+		for (j = 0; j < 6 - 1; j++) {
+			snprintf(pw, bufsize, "%02x", (unsigned char)val[j]);
+			pw += 2;
+		}
+
+		snprintf(pw, bufsize, "%02x ", (unsigned char)val[j]);
+		pw += 3;
+
+		/* Number of operating class - m */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((m = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)m);
+		pw += 3;
+
+		for (j = 0; j < m; j++) {
+			/* Operating class */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+			/* Number of channels - k */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((k = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)k);
+			pw += 3;
+
+			/* channel list */
+			for (q = 0; q < k; q++) {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				if (!token_p)
+					return -1;
+				if ((value = get_value(token_p)) < 0)
+					return -1;
+				snprintf(pw, bufsize, "%02x ",
+					 (unsigned char)value);
+				pw += 3;
+			}
+		}
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
