+int map_dpp_get_local_bootstrap(struct sigma_dut *dut, struct sigma_conn *conn,
+				int send_result, int *success)
+{
+	FILE *map_bootstrap_gen = NULL, *map_bootstrap_get_uri = NULL, *map_bootstrap_key = NULL;
+	char buf[2048];
+	char line[2048], hex[4096];
+	int uri_val, key_val = 0;
+	int radio_id[MAX_RADIO] = {0, 1, 2};
+	int radio_count, radio_no,max=0, index;
+
+	for (radio_count = 0; radio_count < MAX_RADIO; radio_count++) {
+	    snprintf(buf, sizeof(buf), "%s%d", "wifi", radio_count);
+	    for (radio_no = 0; radio_no < MAX_RADIO; radio_no++) {
+		if (!sigma_radio_ifname[radio_no] ||
+		    strcmp(sigma_radio_ifname[radio_no], buf) != 0)
+		    continue;
+		radio_id[radio_no] = radio_count;
+		max++;
+	    }
+	}
+	index = max - 1;
+	if (success)
+		*success = 0;
+
+	/* remove all old key */
+	snprintf(buf, sizeof(buf), "hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_bootstrap_remove '*'",
+		    radio_id[index], radio_id[index]);
+	run_system(dut, buf);
+
+	/*get the bootstrap key*/
+	snprintf(buf, sizeof(buf), "hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_configurator_add curve=P-256",
+		      radio_id[index], radio_id[index]);
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "Running '%s'", buf);
+	map_bootstrap_key = popen(buf, "r");
+	if (!map_bootstrap_key) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, Falled bootstrap_key_index");
+		goto out_err;
+	}
+
+	if (fgets(line, sizeof(line), map_bootstrap_key) == NULL ) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, bootstrap_key_index no line");
+		goto out_err;
+	}
+
+	key_val = atoi(line);
+	snprintf(buf, sizeof(buf), "hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_configurator_get_key %d",
+		 radio_id[index], radio_id[index], key_val);
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "Running '%s'", buf);
+	map_bootstrap_key = popen(buf, "r");
+	if (!map_bootstrap_key) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode, Failed bootstrap_get_key");
+		goto out_err;
+	}
+
+	if (fgets(line, sizeof(line), map_bootstrap_key) == NULL ) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, bootstrap_key no line");
+		goto out_err;
+	}
+
+	if (send_result) {
+		ascii2hexstr(line, hex);
+		snprintf(dut->map_local_bootstrapping_key, sizeof(dut->map_local_bootstrapping_key), "%s", line);
+		run_system_wrapper(dut,"uci set repacd.MAPConfig.DPPKey=%s", line);
+	}
+
+	/* get URI value */
+	snprintf(buf, sizeof(buf), "hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_bootstrap_gen type=qrcode key=%s",
+		 radio_id[index], radio_id[index], line);
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "Running '%s'", buf);
+	map_bootstrap_gen = popen(buf, "r");
+	if (!map_bootstrap_gen) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, Falled bootstrap_gen");
+		goto out_err;
+	}
+
+	if (fgets(line, sizeof(line), map_bootstrap_gen) == NULL ) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, bootstrap_gen no line");
+		goto out_err;
+	}
+
+	uri_val = atoi(line);
+	snprintf(buf, sizeof(buf), "hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_bootstrap_get_uri %d",
+		 radio_id[index], radio_id[index], uri_val);
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "Running '%s'", buf);
+	map_bootstrap_get_uri = popen(buf, "r");
+	if (!map_bootstrap_get_uri) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode, Falled bootstrap_get_uri");
+		goto out_err;
+	}
+	if (fgets(line, sizeof(line), map_bootstrap_get_uri) == NULL ) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+	    "errorCode, bootstrap_get_uri no line");
+		goto out_err;
+	}
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "URI: %s", line);
+
+	if (send_result) {
+		ascii2hexstr(line, hex);
+		snprintf(dut->map_local_bootstrapping_data, sizeof(dut->map_local_bootstrapping_data), "%s", line);
+		run_system_wrapper(dut,"uci set repacd.MAPConfig.DPPMyBootstrap=\'%s\'", line);
+		run_system_wrapper(dut,"uci commit repacd");
+		snprintf(line, sizeof(line), "BootstrappingData,%s", hex);
+		send_resp(dut, conn, SIGMA_COMPLETE, line);
+	}
+
+	if (map_bootstrap_gen)
+		pclose(map_bootstrap_gen);
+	if (map_bootstrap_get_uri)
+		pclose(map_bootstrap_get_uri);
+	if (map_bootstrap_key) {
+		pclose(map_bootstrap_key);
+		run_system_wrapper(dut,
+			"hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_configurator_remove %d",
+						      radio_id[index], radio_id[index], key_val);
+	}
+	if (success)
+		*success = 1;
+	return 0;
+
+out_err:
+	if (map_bootstrap_gen)
+		pclose(map_bootstrap_gen);
+	if (map_bootstrap_get_uri)
+		pclose(map_bootstrap_get_uri);
+	if (map_bootstrap_key) {
+		pclose(map_bootstrap_key);
+		run_system_wrapper(dut,
+			"hostapd_cli -i ath%d -p /var/run/hostapd-wifi%d dpp_configurator_remove %d",
+						      radio_id[index], radio_id[index], key_val);
+	}
+
+	return -2;
+}
