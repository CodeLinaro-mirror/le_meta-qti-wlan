+/*
+ * MAP utilities
+ */
+static int map_get_ifname_apmode(struct sigma_dut *dut, const char *ssid, char *ifname)
+{
+	char buf[512];
+	int rc = -1;
+	bool found = false;
+	int i = 0;
+	FILE *ssid_file = NULL, *mode_file = NULL, *ifname_file = NULL;
+
+	while (i != 30 && !found) {
+		/* Get the ssid */
+		snprintf(buf, sizeof(buf), "uci get wireless.@wifi-iface[%d].ssid", i);
+		ssid_file = popen (buf, "r");
+		if (ssid_file) {
+			fgets (buf, sizeof(buf), ssid_file);
+			if (strncasecmp(buf, ssid, strlen(buf)-1 ) == 0) {
+				snprintf(buf, sizeof(buf), "uci get wireless.@wifi-iface[%d].mode", i);
+				mode_file = popen (buf, "r");
+				if (mode_file) {
+					fgets (buf, sizeof(buf), mode_file);
+					if (strncasecmp(buf, "ap", 2) == 0) {
+						snprintf(buf, sizeof(buf),
+							"uci -q -P /var/state get wireless.@wifi-iface[%d].ifname", i);
+						ifname_file = popen (buf, "r");
+						if (ifname_file) {
+							fgets (buf, sizeof(buf), ifname_file);
+							strlcpy(ifname, buf, strlen(buf));
+							rc = 1;
+							found = true;
+						}
+					}
+				}
+			}
+		}
+		i++;
+	}
+
+	if (ssid_file)
+		pclose(ssid_file);
+	if (mode_file)
+		pclose(mode_file);
+	if (ifname_file)
+		pclose(ifname_file);
+
+	return rc;
+}
