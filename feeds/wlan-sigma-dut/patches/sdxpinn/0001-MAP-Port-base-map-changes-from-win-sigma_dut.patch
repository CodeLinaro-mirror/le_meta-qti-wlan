+static int map_parse_qosm_descriptor_tlv(struct sigma_dut *dut, const char *mod,
+					 char *buf, size_t bufsize)
+{
+	/* tlvtype = 0xDC */
+	unsigned char map_addr[ETH_ALEN];
+	char token[4096], *token_p, *temp_pr, *saveptr, val[256];
+	int value, i = 0, j, k = 0;
+	size_t theLen = 0;
+	long long value1;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+
+	dut->map_pw = buf;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xDC;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* QMID */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%04x ", (uint16_t)value);
+	dut->map_pw += 5;
+
+	/*BSSID */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if (parse_mac_address(dut, token_p, map_addr) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+		 map_addr[0], map_addr[1], map_addr[2],
+		 map_addr[3], map_addr[4], map_addr[5]);
+	dut->map_pw += 13;
+
+	/* Client MAC */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+	       return -1;
+	if (parse_mac_address(dut, token_p, map_addr) < 0)
+	       return -1;
+	snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+		map_addr[0], map_addr[1], map_addr[2],
+		map_addr[3], map_addr[4], map_addr[5]);
+	dut->map_pw += 13;
+
+	/* QoSM Descriptors */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	while (token_p) {
+		theLen = strlen(token_p);
+		i++;sigma_dut_print(dut, DUT_MSG_INFO, "MAP: i=%d  len=%zu  value=%s", i, theLen, token_p);
+
+		if (theLen == 10) {
+			temp_pr = token_p + 1;
+			if (*temp_pr != 'x' && *temp_pr != 'X')
+				return -1;
+
+			value1 = strtoll(token_p, NULL, 0);
+
+			snprintf(dut->map_pw, bufsize, "%08x ", (uint32_t)value1);
+
+		} else {
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+
+			if (theLen == 4 )
+				snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+			else if (theLen == 6)
+				snprintf(dut->map_pw, bufsize, "%04x ", (uint16_t)value);
+			else if (theLen == 8) {
+				k = 3;
+
+				if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+					return -1;
+
+				for (j = 0; j < k - 1; j++) {
+					snprintf(dut->map_pw, bufsize, "%02x", (unsigned char)val[j]);
+					dut->map_pw += 2;
+				}
+
+				snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+				dut->map_pw += 3;
+		       }
+		       else
+				{sigma_dut_print(dut, DUT_MSG_INFO, "MAP: I am Here");return -1;}
+
+		}
+
+		       token_p = strtok_r(NULL, " ", &saveptr);
+
+		       if ( theLen != 8)
+			       dut->map_pw += (theLen - 1);
+	}
+
+	/* done */
+	return ((i < 1) ? -1 : 1);
+}
