+static int cmd_dev_set_trigger(struct sigma_dut *dut, struct sigma_conn *conn, struct sigma_cmd *cmd)
+{
+#if defined(__linux__)
+
+	int sock;
+	struct sockaddr_un serveraddr = {AF_UNIX, MAP_SERVER_SOCKET};
+	char resp[1024];
+	char tx_buffer[MAP_MAX_PAYLOAD_SIZE] = {0};
+	const char* responce = "dpppresenceannouncementblock,action,";
+	const char* enable = "enable";
+	const char* disable = "disable";
+
+
+
+	struct apac_map_sock_tlv *tx_message =
+	    (struct apac_map_sock_tlv *)tx_buffer;
+
+	const char *val;
+
+	val = get_param(cmd, "action");
+	memset(resp,0,sizeof(resp));
+	memcpy(resp, responce, strlen(responce));
+	if (val && strcasecmp(val, "enable") == 0) {
+		memcpy(&resp[strlen(responce)], enable, strlen(enable));
+		resp[strlen(responce) + strlen(enable)] = '\0';
+	}
+	else if (val && strcasecmp(val, "disable") == 0){
+		memcpy(&resp[strlen(responce)], disable, strlen(disable));
+		resp[strlen(responce) + strlen(disable)] = '\0';
+	}
+	else {
+		val = get_param(cmd, "trigger");
+		sigma_dut_print(dut, DUT_MSG_DEBUG,"%s\n", val);
+		if (val && strcasecmp(val, "deauthentication") == 0) {
+			val = get_param(cmd, "STAMACAddress");
+			sigma_dut_print(dut, DUT_MSG_DEBUG,"%s\n", val);
+			if (val && map_dpp_deauth(dut, val) == 1)
+				return 1;;
+		}
+		sigma_dut_print(dut, DUT_MSG_ERROR, "Invalid Value");
+		return -1;
+	}
+
+	/**tx: Create socket on which to send. */
+	sock = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (sock < 0) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode,MAP failed to create tx socket");
+		return -1;
+	}
+
+	/*tx: Prepare data to be transmitted */
+	memset(tx_buffer, 0, sizeof(tx_buffer));
+	tx_message->type = (uint8_t) 0xff;
+	tx_message->len = (uint16_t)strlen(resp);
+	tx_message->msgtype = (uint16_t)0xffff;
+	//parse_mac_address(dut, map_alid, tx_message->alid);
+	memcpy(tx_message->content, resp, strlen(resp) + 1);
+
+	/**tx: Construct name of socket to send to. */
+	memset(&serveraddr, 0, sizeof(serveraddr));
+	serveraddr.sun_family = AF_UNIX;
+	strlcpy(serveraddr.sun_path, MAP_SERVER_SOCKET,
+		sizeof(serveraddr.sun_path));
+
+	/**tx: Send tx_message. */
+	sendto(sock, tx_buffer, 1500, 0,
+	       (const struct sockaddr *)&serveraddr,
+	       sizeof(struct sockaddr_un));
+
+	send_resp(dut, conn, SIGMA_COMPLETE, resp);
+
+	close(sock);
+
+	return 1;
+
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		"errorCode,dev_set_trigger not supported");
+	return -1;
+#endif /* __linux__ */
+}
