+static int map_parse_steering_request_tlv(struct sigma_dut *dut,
+					  const char *mod, char *buf,
+					  size_t bufsize,
+					  unsigned int map_tlvtype)
+{
+	/* tlvtype = 0x9B or 0xC3*/
+	unsigned char map_sta_addr[6];
+	unsigned char map_bssid[6];
+	char token[4096], *token_p, *saveptr;
+	int i, k, m;
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+
+	strlcpy(token, mod, sizeof(token));
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	char *pw = buf;
+
+	memset(buf, 0, bufsize);
+
+	if (parse_mac_address(dut, token_p, map_bssid) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_bssid[0],
+		 map_bssid[1], map_bssid[2], map_bssid[3], map_bssid[4],
+		 map_bssid[5]);
+	pw += 13;
+
+	/* Request Mode */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	int value;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* Steering Opportunity Window.  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%04x ", (uint16_t)value);
+	pw += 5;
+
+	/* BTM Disassociation Timer */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%04x ", (uint16_t)value);
+	pw += 5;
+
+	/* STA List Count k  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)k);
+	pw += 3;
+
+	for (i = 0; i < k; i++) {
+		/* STA MAC address -loop k-1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_sta_addr[0], map_sta_addr[1], map_sta_addr[2],
+			 map_sta_addr[3], map_sta_addr[4], map_sta_addr[5]);
+		pw += 13;
+	}
+
+	/* Target BSSID List Count m */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((m = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)m);
+	pw += 3;
+
+	for (i = 0; i < m; i++) {
+		/* Target BSSID -loop m-1*/
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_bssid) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_bssid[0],
+			 map_bssid[1], map_bssid[2], map_bssid[3], map_bssid[4],
+			 map_bssid[5]);
+		pw += 13;
+
+		/* Target BSS Operating Class */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+
+		/* Target BSS Channel Number */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+
+		/* Reason Code */
+		if (map_tlvtype == IEEE1905_TLV_TYPE_R2_STEERING_REQUEST) {
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+		}
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
