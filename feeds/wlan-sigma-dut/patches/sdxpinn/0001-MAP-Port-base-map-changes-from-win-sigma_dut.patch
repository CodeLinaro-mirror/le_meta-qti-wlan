+static int map_parse_steering_policy_tlv(struct sigma_dut *dut, const char *mod,
+					 char *buf, size_t bufsize)
+{
+	/* tlvtype = 0x89 */
+	unsigned char map_sta_addr[6];
+	unsigned char map_ruid[6];
