+static int map_get_bssid(struct sigma_dut *dut, const char *ssid, char *ruid,
+			 char *ifname, char *bssid)
+{
+	char line1[512];
+	int rc = -1;
+	char the_ssid[64];
+	bool found = false;
+	char *token_p[512];
+	char *saveptr;
+	char ifname_temp[16];
+	FILE *file;
+	int p;
+
+	the_ssid[0] = '\0';
+
+	snprintf(the_ssid, sizeof(the_ssid), "ESSID:\"%s\"", ssid);
+
+	file = popen("iwconfig", "r");
+	if (!file)
+		goto map_get_bssid_out;
+
+	while ((fgets(line1, sizeof(line1), file) != NULL) && !found) {
+		p = 0;
+		token_p[p] = strtok_r(line1, " ", &saveptr);
+		if (token_p[p]) {
+			while (((token_p[++p] =
+				     strtok_r(NULL, " ", &saveptr)) != NULL) &&
+			       !found) {
+				if (strcmp(token_p[p], the_ssid) == 0) {
+					strlcpy(ifname, token_p[0],
+						strlen(token_p[0]) + 1);
+					strlcpy(ifname_temp, ifname,
+						strlen(ifname) + 1);
+					ifname_temp[4] = '\0';
+					if (map_is_ifname(dut, ruid,
+							 ifname_temp) &&
+							strncasecmp(ifname, dut->map_ifname, strlen(dut->map_ifname)) == 0) {
+						if (fgets(line1, sizeof(line1),
+							  file) == NULL) {
+							pclose(file);
+							goto map_get_bssid_out;
+						}
+
+						rc = map_find_bssid(
+						    dut, line1, (bool *)&found,
+						    bssid);
+					}
+				}
+			}
+		}
+	}
+	pclose(file);
+
+map_get_bssid_out:
+	return rc;
+}
