+static int map_enable_lan(struct sigma_dut *dut)
+{
+	char lan_ifname[512], cmdline[64];
+	char *ifa_name, *saveptr;
+	bool found = false;
+	FILE *netwrk;
+
+	netwrk = popen("uci get network.lan.ifname", "r");
+	if (!netwrk)
+		goto map_enable_lan_error;
+
+	memset(lan_ifname, 0, sizeof(lan_ifname));
+	while (fgets(lan_ifname, sizeof(lan_ifname), netwrk) != NULL &&
+	       !found) {
+		ifa_name = strtok_r(lan_ifname, " ", &saveptr);
+		while (ifa_name != NULL) {
+			found = true;
+			ifa_name[4] = '\0';
+			snprintf(cmdline, sizeof(cmdline), "ifconfig %s up",
+				 ifa_name);
+			run_system_wrapper(dut, cmdline);
+			ifa_name = strtok_r(NULL, " ", &saveptr);
+		}
+	}
+	pclose(netwrk);
+	netwrk = NULL;
+	if (found)
+		return 1;
+
+map_enable_lan_error:
+	netwrk = NULL;
+	return -1;
+}
