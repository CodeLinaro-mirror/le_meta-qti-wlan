+static int map_set_NonRelayingEthernetInterface(struct sigma_dut *dut)
+{
+	char lan_ifname[512], carrier[512], cmdline[64];
+	char *ifa_name, *saveptr;
+	bool found = false;
+	FILE *netwrk, *fcarrier;
+
+	netwrk = popen("uci get network.lan.ifname", "r");
+	if (!netwrk)
+		goto map_set_NonRelayingEthernetInterface_error;
+
+	memset(lan_ifname, 0, sizeof(lan_ifname));
+	while (fgets(lan_ifname, sizeof(lan_ifname), netwrk) != NULL &&
+	       !found) {
+		ifa_name = strtok_r(lan_ifname, " ", &saveptr);
+		while (ifa_name != NULL && !found) {
+			ifa_name[4] = '\0';
+			snprintf(cmdline, sizeof(cmdline),
+				 "cat /sys/class/net/%s/carrier", ifa_name);
+			fcarrier = popen(cmdline, "r");
+			if (fcarrier) {
+				fgets(carrier, sizeof(carrier), fcarrier);
+				pclose(fcarrier);
+				carrier[1] = '\0';
+				if (strcmp(carrier, "1") == 0) {
+					found = true;
+					snprintf(
+					    cmdline, sizeof(cmdline),
+					    "uci set "
+					    "ezmesh.config."
+					    "NonRelayingEthernetInterface=%s",
+					    ifa_name);
+					run_system_wrapper(dut, cmdline);
+				}
+			}
+			ifa_name = strtok_r(NULL, " ", &saveptr);
+		}
+	}
+	pclose(netwrk);
+	netwrk = fcarrier = NULL;
+	if (found)
+		return 1;
+
+map_set_NonRelayingEthernetInterface_error:
+	netwrk = fcarrier = NULL;
+	return -1;
+}
