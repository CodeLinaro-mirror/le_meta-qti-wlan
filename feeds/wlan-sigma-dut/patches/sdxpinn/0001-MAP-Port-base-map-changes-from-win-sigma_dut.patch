+static int map_parse_spatial_reuse_request_tlv(struct sigma_dut *dut,
+					  const char *mod, char *buf,
+					  size_t bufsize)
+{
+	/* tlvtype = 0xD8 */
+	char token[4096], *token_p, *saveptr;
+	unsigned char map_ruid[6];
+	long unsigned int value;
+	int i;
+
+	dut->map_pw = buf;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xD8;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* RUID */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if (parse_mac_address(dut, token_p, map_ruid) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_ruid[0],
+		 map_ruid[1], map_ruid[2], map_ruid[3], map_ruid[4],
+		 map_ruid[5]);
+	dut->map_pw += 13;
+
+       /* BSS Color */
+       /** bit7-6 Reserved */
+       /** bit5-0 The value of the BSS Color */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Bit Fields */
+	/** bit7-5 Reserved */
+	/** bit 4 HESIGA_Spatial_reuse_value15_allowed */
+	/** bit 3 SRG Information Valid */
+	/** bit 2 Non-SRG_Offset_Valid */
+	/** bit 1 Reserved */
+	/** bit 0 PSR Disallowed */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Non-SRG_OBSSPD_max_Offset - bit 2  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* SRG_OBSSPD_Min_Offset - bit 3  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* SRG_OBSSPD_Max_Offset - bit 3  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* SRG BSS Color Bitmap - bit 3 - 8 octets */
+	for (i = 0; i < 8; i++) {
+	       	token_p = strtok_r(NULL, " ", &saveptr);
+	       	if (!token_p)
+		       	return -1;
+	       	if ((value = get_value(token_p)) < 0)
+		       	return -1;
+	       	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	       	dut->map_pw += 3;
+	}
+
+	/* SRG Partial BSSID Bitmap - bit 3 - 8 octets */
+	for (i = 0; i < 8; i++) {
+	       	token_p = strtok_r(NULL, " ", &saveptr);
+	       	if (!token_p)
+		       	return -1;
+	       	if ((value = get_value(token_p)) < 0)
+		       	return -1;
+	       	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	       	dut->map_pw += 3;
+	}
+
+	/* Reserved 2 octets */
+	for (i = 0; i < 2; i++) {
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
