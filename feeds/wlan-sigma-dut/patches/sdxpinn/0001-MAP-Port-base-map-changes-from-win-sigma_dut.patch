+/*
+ * cmd_dev_send_1905 - TLV parsing
+ */
+
+static int map_parse_unassoc_sta_link_metrics_query_tlv(struct sigma_dut *dut,
+							const char *mod,
+							char *buf,
+							size_t bufsize)
+{
+	/* tlvtype = 0x97 */
+	unsigned char map_sta_addr[6];
+	char token[4096], *token_p, *saveptr;
+	int i, j, k, m = 0; /* for loops k and m */
+	int value;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	char *pw = buf;
+	memset(buf, 0, bufsize);
+	strlcpy(token, mod, sizeof(token));
+
+	/* Operating Class */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* Number of channels spacifiend in the channel list - k*/
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)k);
+	pw += 3;
+
+	for (i = 0; i < k; i++) {
+		/* channel list  k- 1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+
+		/* Number of STA MAC addresses included in this tlv - m */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((m = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)m);
+		pw += 3;
+
+		for (j = 0; j < m; j++) {
+			/* STA MAC address -loop m-1 */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+				 map_sta_addr[0], map_sta_addr[1],
+				 map_sta_addr[2], map_sta_addr[3],
+				 map_sta_addr[4], map_sta_addr[5]);
+			pw += 13;
+		} /* m-1 */
+	}	 /* k-1 */
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
+
+static int map_parse_ap_metrics_tlv(struct sigma_dut *dut, const char *mod,
+				    char *buf, size_t bufsize)
+{
+	/* tlvtype = 0x94 */
+	unsigned char map_bssid[6];
+	char token[4096], *token_p, *saveptr;
+	char val[256];
+	int j, k; /* for loops h, k and m */
+	int value;
+	int espi_flags;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	dut->map_pw = buf;
+	memset(buf, 0, bufsize);
+
+	value = 0x94;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* BSSID */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if (parse_mac_address(dut, token_p, map_bssid) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+		 map_bssid[0], map_bssid[1], map_bssid[2], map_bssid[3],
+		 map_bssid[4], map_bssid[5]);
+	dut->map_pw += 13;
+
+	/* Channel Utilization */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* uint total number of STAS associated to this BSS */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%04x ", (uint16_t)value);
+	dut->map_pw += 5;
+
+	/* flags for Estimated Service Parameter Information */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((espi_flags = value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	k = 3;
+	/* Estimated Service Parmaters Information AC=BE */
+	if ((token_p = strtok_r(NULL, " ", &saveptr)) == NULL)
+		return -1;
+
+	if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+		return -1;
+
+	/* Channel List - k-1*/
+	for (j = 0; j < k - 1; j++) {
+		snprintf(dut->map_pw, bufsize, "%02x", (unsigned char)val[j]);
+		dut->map_pw += 2;
+	}
+
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+	dut->map_pw += 3;
+
+	/* Estimated Service Parmaters Information AC=BK */
+	if (espi_flags & (1 << 6)) {
+		if ((token_p = strtok_r(NULL, " ", &saveptr)) == NULL)
+			return -1;
+
+		if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+			return -1;
+
+		/* Channel List - k-1*/
+		for (j = 0; j < k - 1; j++) {
+			snprintf(dut->map_pw, bufsize, "%02x",
+				 (unsigned char)val[j]);
+			dut->map_pw += 2;
+		}
+
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+		dut->map_pw += 3;
+	}
+
+	/* Estimated Service Parmaters Information AC=VO */
+	if (espi_flags & (1 << 5)) {
+		if ((token_p = strtok_r(NULL, " ", &saveptr)) == NULL)
+			return -1;
+
+		if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+			return -1;
+
+		/* Channel List - k-1*/
+		for (j = 0; j < k - 1; j++) {
+			snprintf(dut->map_pw, bufsize, "%02x",
+				 (unsigned char)val[j]);
+			dut->map_pw += 2;
+		}
+
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+		dut->map_pw += 3;
+	}
+
+	/* Estimated Service Parmaters Information AC=VI */
+	if (espi_flags & (1 << 4)) {
+		if ((token_p = strtok_r(NULL, " ", &saveptr)) == NULL)
+			return -1;
+
+		if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+			return -1;
+
+		/* Channel List - k-1*/
+		for (j = 0; j < k - 1; j++) {
+			snprintf(dut->map_pw, bufsize, "%02x",
+				 (unsigned char)val[j]);
+			dut->map_pw += 2;
+		}
+
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
