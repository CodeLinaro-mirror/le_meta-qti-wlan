+static bool map_is_ifname(struct sigma_dut *dut, const char *mac,
+			  const char *ifname)
+{
+	unsigned char map_mac[6];
+	bool rc = false;
+	char *ifname_temp;
+	struct ifreq ifr;
+	int s;
+
+	parse_mac_address(dut, mac, map_mac);
+	s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (s < 0)
+		return rc;
+
+	if (strcmp(ifname, "ath0") == 0)
+		ifname_temp = "wifi0";
+	else if (strcmp(ifname, "ath1") == 0)
+		ifname_temp = "wifi1";
