+static int map_parse_service_prioritization_rule_tlv(struct sigma_dut *dut,
+						     const char *mod, char *buf,
+						     size_t bufsize)
+{
+	/* tlvtype = 0xB9 */
+	char token[4096], *token_p, *saveptr, val[16];
+	unsigned char map_macaddr[6];
+	uint8_t rule_match, add_remove_filter;
+	int value, j, k;
+	dut->map_pw = buf;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xB9;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Service Prioritization Rule Identifier */
+	token_p = strtok_r(token, " ",  &saveptr);
+	if (!token_p)
+		return -1;
+
+	k = 4;
+	if (prsna2x(dut, token_p, (size_t)k, (unsigned char *)val) < 0)
+		return -1;
+
+	for (j = 0; j < k - 1; j++) {
+		snprintf(dut->map_pw, bufsize, "%02x", (unsigned char)val[j]);
+		dut->map_pw += 2;
+	}
+
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)val[j]);
+	dut->map_pw += 3;
+
+	/* Add-Remove filter  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+	add_remove_filter = (uint8_t)value;
+	if (!(add_remove_filter & (1 << 7)))
+		return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+
+	/* Rule Precedence  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Rule Output  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Rule Match bit 7 Always True */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	rule_match = (uint8_t)value;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	if (rule_match & (1 << 5)) {
+		/* UP in 802.11 QoS Control Flag - bit 5  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	if (rule_match & (1 << 3)) {
+		/* Source Mac Address bit 3*/
+		token_p = strtok_r(NULL, " ",  &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_macaddr) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_macaddr[0],
+			map_macaddr[1], map_macaddr[2], map_macaddr[3], map_macaddr[4],
+			map_macaddr[5]);
+		dut->map_pw += 13;
+	}
+
+	if (rule_match & (1 << 1)) {
+		/* Destination Mac Address bit 1 */
+		token_p = strtok_r(NULL, " ",  &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_macaddr) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_macaddr[0],
+			map_macaddr[1], map_macaddr[2], map_macaddr[3], map_macaddr[4],
+			map_macaddr[5]);
+		dut->map_pw += 13;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
