+static int map_parse_qosm_policy_tlv(struct sigma_dut *dut, const char *mod,
+				     char *buf, size_t bufsize)
+{
+	/* tlvtype = 0xDB */
+	unsigned char map_sta_addr[6];
+	char token[4096], *token_p, *saveptr;
+	int i, k, m; /* for loops k and m */
+	int value;
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	dut->map_pw = buf;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xDB;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* MSCS Operation Disallowed STA Count k  */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)k);
+	dut->map_pw += 3;
+
+	for (i = 0; i < k; i++) {
+		/* STA MAC address -loop k-1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_sta_addr[0], map_sta_addr[1], map_sta_addr[2],
+			 map_sta_addr[3], map_sta_addr[4], map_sta_addr[5]);
+		dut->map_pw += 13;
+	}
+
+	/* SCS Operation Disallowed STA Count m  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((m = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)m);
+	dut->map_pw += 3;
+
+	if (m == 0) {
+		for (i = 0; i < ETH_ALEN; i++) {
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+			dut->map_pw += 3;
+		}
+	} else {
+		for (i = 0; i < m; i++) {
+			/* STA MAC address -loop m-1 */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+				return -1;
+			snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+				 map_sta_addr[0], map_sta_addr[1], map_sta_addr[2],
+				 map_sta_addr[3], map_sta_addr[4], map_sta_addr[5]);
+			dut->map_pw += 13;
+		}
+	}
+
+	/* Reserved */
+	for (i = 0; i < 20; i++) {
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
