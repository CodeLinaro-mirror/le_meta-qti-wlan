+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	dut->map_pw = buf;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0x89;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Local Steering Disallowed STA Count h  */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((h = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)h);
+	dut->map_pw += 3;
+
+	for (i = 0; i < h; i++) {
+		/* STA MAC address -loop h-1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_sta_addr[0], map_sta_addr[1], map_sta_addr[2],
+			 map_sta_addr[3], map_sta_addr[4], map_sta_addr[5]);
+		dut->map_pw += 13;
+	}
+
+	/* BTM Steering Disallowed STA Count k  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)k);
+	dut->map_pw += 3;
+
+	for (i = 0; i < k; i++) {
+		/* STA MAC address -loop k-1 */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_sta_addr) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_sta_addr[0], map_sta_addr[1], map_sta_addr[2],
+			 map_sta_addr[3], map_sta_addr[4], map_sta_addr[5]);
+		dut->map_pw += 13;
+	}
+
+	/* BTM Steering Disallowed STA Count m  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((m = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)m);
+	dut->map_pw += 3;
+
+	/* loop m-1 */
+	for (i = 0; i < m; i++) {
+		/* RUID */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_ruid) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_ruid[0], map_ruid[1], map_ruid[2], map_ruid[3],
+			 map_ruid[4], map_ruid[5]);
+		dut->map_pw += 13;
+
+		/* Steering Policy  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+
+		/* Channel Utilization Threshold  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+
+		/* RSSI Steering Threshold  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
