+	char map_tlvlength[15];
+	dut->map_mid = 0;
+	unsigned char map_addr[6] = {0};
+	unsigned int map_msgtypeval_i;
+	FILE *pfd;
+	char ic[3];
+	char tlvtype[16] = "tlv_type";
+	char tlvlength[16] = "tlv_length";
+	char tlvvalue[16] = "tlv_value";
+	bool one_more = true;
+	int i = 1;
+	char mod[4096];
+
+	dut->map_tlvcnt = 0;
+	dut->map_multi_tlv = false;
+	dut->map_tlvvalue[0] = '\0';
+
+	val = get_param(cmd, "DestALid");
+	if (val) {
+		if (parse_mac_address(dut, val, map_addr) < 0) {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,MAP invalid DestALid");
+			goto map_send_1905_error;
+		}
+
+		sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: DestAlid: %s", val);
+	}
+
+	dut->map_pw = buf;
+
+	snprintf(dut->map_pw, sizeof(buf), "%02x ", (unsigned char)0);
+	dut->map_pw += 3;
+
+	while (one_more) {
+		val = get_param(cmd, tlvtype);
+		if (val) {
+			if (strlen(val) > sizeof(map_tlvtype) - 1) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,MAP invalid tlvtype");
+				goto map_send_1905_error;
+			}
+			snprintf(map_tlvtype, sizeof(map_tlvtype), "%s", val);
+			dut->map_tlvtype = (unsigned int)get_value(map_tlvtype);
+
+			if (i == 1) {
+				one_more = false;
+			}
+
+			dut->map_tlvcnt++;
+
+			sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: tlvtype: %s",
+					map_tlvtype);
+
+			val = get_param(cmd, tlvlength);
+			if (val) {
+				if (strlen(val) > sizeof(map_tlvlength) - 1) {
+					send_resp(
+					    dut, conn, SIGMA_ERROR,
+					    "errorCode,MAP invalid tlvlength");
+					goto map_send_1905_error;
+				}
+				snprintf(map_tlvlength, sizeof(map_tlvlength),
+					 "%s", val);
+				sigma_dut_print(dut, DUT_MSG_DEBUG,
+						"MAP: tlvlength: %s",
+						map_tlvlength);
+			}
+
+			val = get_param(cmd, tlvvalue);
+			if (val) {
+				map_removeAllCurlyBrackets(val, mod);
+				if (map_parse_tlvvalue(dut, mod, buf,
+						       sizeof(buf), i) < 0) {
+					send_resp(dut, conn, SIGMA_ERROR,
+						  "errorCode,MAP failed to "
+						  "parse tlv");
+					goto map_send_1905_error;
+				}
+			}
+
+			snprintf(ic, sizeof(ic), "%02x ", (unsigned char)i++);
+			tlvtype[8] = tlvlength[10] = tlvvalue[9] = ic[1];
+			tlvtype[9] = tlvlength[11] = tlvvalue[10] = '\0';
+
+		} else if (i == 1) {
+			one_more = true;
+			snprintf(ic, sizeof(ic), "%02x ", (unsigned char)i++);
+			tlvtype[8] = tlvlength[10] = tlvvalue[9] = ic[1];
+			tlvtype[9] = tlvlength[11] = tlvvalue[10] = '\0';
+
+		} else {
+			if (dut->map_multi_tlv) {
+				snprintf(ic, sizeof(ic), "%02x ",
+					 (unsigned char)dut->map_tlvcnt);
+				buf[0] = ic[0];
+				buf[1] = ic[1];
+				strlcpy(dut->map_tlvvalue, buf,
+					sizeof(dut->map_tlvvalue));
+			}
+
+			one_more = false;
+		}
+	}
+
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: tlvvalue: %s",
+			dut->map_tlvvalue);
+
+	val = get_param(cmd, "MessageTypeValue");
+	if (val) {
+		if (strlen(val) > sizeof(dut->map_msgtypeval) - 1)
+			goto map_send_1905_error;
+
+		snprintf(dut->map_msgtypeval, sizeof(dut->map_msgtypeval), "%s",
+			 val);
+		sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: msgtypevalue: %s",
+				dut->map_msgtypeval);
+
+		map_msgtypeval_i = get_value(dut->map_msgtypeval);
+
+		switch (map_msgtypeval_i) {
+
+		case IEEE1905_MSG_TYPE_AP_AUTOCONFIGURATION_RENEW:
+			snprintf(buf, sizeof(buf), "%02x%02x%02x%02x%02x%02x",
+				 map_addr[0], map_addr[1], map_addr[2],
+				 map_addr[3], map_addr[4], map_addr[5]);
+			strlcpy(dut->map_alid, buf, sizeof(dut->map_alid));
+
+			pfd = fopen("/tmp/renew_alid.tmp", "w");
+			if (pfd == NULL) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,MAP fopen failure");
+				goto map_send_1905_error;
+			}
+			fprintf(pfd, "%s", dut->map_alid);
+			fclose(pfd);
+
+			if (map_ap_autoconfiguration_renew_message(dut) < 1) {
+				send_resp(
+				    dut, conn, SIGMA_ERROR,
+				    "errorCode,MAP renew message failure");
+				goto map_send_1905_error;
+			}
+			snprintf(resp, sizeof(resp), "MID,0x%02x",
+				 dut->map_mid);
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_send_1905_ok;
+
+			break;
+
+		case IEEE1905_MSG_TYPE_CLIENT_CAPABILITY_QUERY:
+		case IEEE1905_MSG_TYPE_TOPOLOGY_QUERY:
+		case IEEE1905_MSG_TYPE_LINK_METRIC_QUERY:
+		case IEEE1905_MSG_TYPE_AP_CAP_QUERY:
+		case IEEE1905_MSG_TYPE_MAP_POLICY_CONFIG:
+		case IEEE1905_MSG_TYPE_CHANNEL_PREFERENCE_QUERY:
+		case IEEE1905_MSG_TYPE_CHANNEL_PREFERENCE_REPORT:
+		case IEEE1905_MSG_TYPE_CHANNEL_SELECTION_REQUEST:
+		case IEEE1905_MSG_TYPE_AP_METRICS_QUERY:
+		case IEEE1905_MSG_TYPE_ASSOC_STA_LINK_METRIC_QUERY:
+		case IEEE1905_MSG_TYPE_UNASSOC_STA_METRIC_REQUEST:
+		case IEEE1905_MSG_TYPE_BEACON_METRICS_QUERY:
+		case IEEE1905_MSG_TYPE_COMBINED_INFRASTRUCTURE_METRICS:
+		case IEEE1905_MSG_TYPE_CLIENT_STEERING_REQUEST:
+		case IEEE1905_MSG_TYPE_CLIENT_ASSOC_CONTROL_REQUEST:
+		case IEEE1905_MSG_TYPE_HIGHER_LAYER_PAYLOAD:
+		case IEEE1905_MSG_TYPE_BACKHAUL_STEERING_REQUEST:
+		case IEEE1905_MSG_TYPE_CHANNEL_SCAN_REQUEST:
+		case IEEE1905_MSG_TYPE_CAC_REQUEST:
+		case IEEE1905_MSG_TYPE_CAC_TERMINATION:
+		case IEEE1905_MSG_TYPE_SERVICE_PRIORITIZATION_REQUEST:
+		case IEEE1905_MSG_TYPE_LOOP_DETECTION_MESSAGE:
+			snprintf(buf, sizeof(buf), "%02x%02x%02x%02x%02x%02x",
+				 map_addr[0], map_addr[1], map_addr[2],
+				 map_addr[3], map_addr[4], map_addr[5]);
+			strlcpy(dut->map_alid, buf, sizeof(dut->map_alid));
+			if (map_test_socket(dut, conn, map_tlvtype,
+					    dut->map_alid, dut->map_msgtypeval,
+					    map_tlvlength,
+					    dut->map_tlvvalue) < 0) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,MAP socket failure");
+				goto map_send_1905_error;
+			}
+			snprintf(resp, sizeof(resp), "MID,0x%02x",
+				 dut->map_mid);
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_send_1905_ok;
+
+			break;
+
+		default:
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Message Type Value "
+				  "not supported");
+			goto map_send_1905_error;
+		}
+	}
+
+	send_resp(dut, conn, SIGMA_ERROR, "errorCode,dev_send_1905 invalid ");
+
+map_send_1905_error:
+	dut->map_pw = NULL;
+	return -1;
+
+map_send_1905_ok:
+	dut->map_pw = NULL;
+	return 0;
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		  "errorCode,dev_send_1905 not supported");
+	return -1;
+#endif /* __linux__ */
+}
+
+static int cmd_dev_reset_default(struct sigma_dut *dut, struct sigma_conn *conn,
+				 struct sigma_cmd *cmd)
+{
+
+#if defined(__linux__)
+	const char *type;
+	const char *type_sav;
+	const char *name;
+	const char *devrole;
+	int radio_id[MAX_RADIO] = {0, 1, 2};
+	int radio_count, radio_no;
+	char buf[64];
+
+	for (radio_count = 0; radio_count < MAX_RADIO; radio_count++) {
+		snprintf(buf, sizeof(buf), "%s%d", "wifi", radio_count);
+		for (radio_no = 0; radio_no < MAX_RADIO; radio_no++) {
+			if (!sigma_radio_ifname[radio_no] ||
+			    strcmp(sigma_radio_ifname[radio_no], buf) != 0)
+				continue;
+			radio_id[radio_no] = radio_count;
+		}
+	}
+
+	// num_radio == 3: radio_id[0] = 5GH, radio_id[1] = 5GL, radio_id[2] = 2.4G
+	// num_radio == 2: radio_id[0] = 5G, radio_id[1] = 2.4G
+
+	dut->map_ath0_onboard = dut->map_ath1_onboard = false;
+	dut->map_ath2_onboard = false;
+
+	dut->program = sigma_program_to_enum(get_param(cmd, "PROGRAM"));
+	dut->device_type = AP_unknown;
+	dut->map_device_role = MAP_DEVROLE_UNKNOWN;
+
+	dut->map_bh24g = dut->map_bh5g = dut->map_bh5gh = false;
+
+	type_sav = "Unknown";
+	type = get_param(cmd, "type");
+	if (type && strcasecmp(type, "Testbed") == 0) {
+		dut->device_type = AP_testbed;
+		type_sav = "Testbed";
+	}
+	if (type && strcasecmp(type, "DUT") == 0) {
+		dut->device_type = AP_dut;
+		type_sav = "DUT";
+	}
+
+	devrole = get_param(cmd, "devrole");
+	if (devrole && strcasecmp(devrole, "controller") == 0)
+		dut->map_device_role = MAP_DEVROLE_CONTROLLER;
+
+	if (devrole && strcasecmp(devrole, "agent") == 0) {
+		dut->map_device_role = MAP_DEVROLE_AGENT;
+		name = get_param(cmd, "name");
+		if (name && !(strcasecmp(type_sav, "DUT") == 0)) {
+			type_sav = strdup(name);
+			if (type_sav == NULL)
+				type_sav = "Unknown";
+		}
+	}
+
+	if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE ||
+	    dut->program == PROGRAM_MAPR2 || dut->program == PROGRAM_MAPR3 ||
+		dut->program == PROGRAM_MAPR4 || dut->program == PROGRAM_MAPR5) {
+		unlink("/tmp/map_auto_renew_mid_5g.tmp");
+		unlink("/tmp/map_auto_renew_mid.tmp");
+		unlink("/tmp/renew_alid.tmp");
+		unlink("/etc/config/map.conf");
+		unlink("/tmp/wsplcd-lan.conf");
+		unlink("/tmp/ezmesh-lan.conf");
+		unlink("/tmp/ieee1905.tmp");
+		unlink(DPP_GET_FRAME_INFO_TEMP_FILE);
+
+		if (dut->map_repacd_enableDPP) {
+			dut->map_repacd_enableDPP = false;
+			run_system_wrapper(dut,
+				"uci set repacd.MAPConfig.MapEnableDPP=1");
+		}
+
+		//run_system_wrapper(dut, "wifi unload");
+#ifdef WIFI_CFG_CMD
+		run_system_wrapper(dut, "wifi config > /etc/config/wireless");
+#else
+		run_system_wrapper(dut, "wifi detect > /etc/config/wireless");
+#endif
+		run_system_wrapper(dut, INIT_SCRIPT_PATH"ezmesh stop");
+		run_system_wrapper(dut, INIT_SCRIPT_PATH"wsplcd stop");
+		run_system_wrapper(dut, "uci set ezmesh.config.Enable=0");
+		run_system_wrapper(dut, "uci set wsplcd.config.HyFiSecurity=0");
+		run_system_wrapper(dut,
+				   "uci set wsplcd.config.DebugLevel=ERROR");
+		if (num_mac_addr > 0) {
+			if (map_set_wifi_macaddr(dut, sigma_wifi_macaddr, radio_id) < 0)
+					sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: mac addrval not set");
+		}
+
+		if (dut->map_device_role == MAP_DEVROLE_CONTROLLER) {
+			/* Set up the defaults */
+			owrt_ap_set_radio(dut, radio_id[0], "disabled", "0");
+			owrt_ap_set_radio(dut, radio_id[1], "disabled", "0");
+			owrt_ap_set_radio(dut, radio_id[0], "htmode", "HT20");
+			owrt_ap_set_radio(dut, radio_id[1], "htmode", "HT20");
+			owrt_ap_set_radio(dut, radio_id[0], "txchainmask", "1");
+			owrt_ap_set_radio(dut, radio_id[1], "txchainmask", "1");
+			owrt_ap_set_radio(dut, radio_id[0], "rxchainmask", "1");
+			owrt_ap_set_radio(dut, radio_id[1], "rxchainmask", "1");
+			if (num_radio == 3) {
+				owrt_ap_set_radio(dut, radio_id[2], "disabled", "0");
+				owrt_ap_set_radio(dut, radio_id[2], "htmode", "HT20");
+				owrt_ap_set_radio(dut, radio_id[2], "txchainmask", "1");
+				owrt_ap_set_radio(dut, radio_id[2], "rxchainmask", "1");
+				owrt_ap_set_radio(dut, radio_id[0], "channel", "149");
+				owrt_ap_set_radio(dut, radio_id[1], "channel", "36");
+				owrt_ap_set_radio(dut, radio_id[2], "channel", "6");
+				owrt_ap_set_vap(dut, radio_id[2], "wds", "1");
+				if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE) {
+					owrt_ap_set_vap(dut, radio_id[2], "map", "1");
+				} else {
+									owrt_ap_set_vap(dut, radio_id[2], "map", "2");
+									owrt_ap_set_radio(dut, radio_id[2], "no_vlan", "1");
+				}
+									owrt_ap_set_vap(dut, radio_id[2], "MapBSSType", "32");
+			} else {
+				owrt_ap_set_radio(dut, radio_id[0], "channel", "36");
+				owrt_ap_set_radio(dut, radio_id[1], "channel", "6");
+			}
+
+			owrt_ap_set_vap(dut, radio_id[0], "wds", "1");
+			owrt_ap_set_vap(dut, radio_id[1], "wds", "1");
+			if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE ) {
+				owrt_ap_set_vap(dut, radio_id[0], "map", "1");
+				owrt_ap_set_vap(dut, radio_id[1], "map", "1");
+			} else {
+				owrt_ap_set_vap(dut, radio_id[0], "map", "2");
+				owrt_ap_set_vap(dut, radio_id[1], "map", "2");
+				owrt_ap_set_radio(dut, radio_id[0], "no_vlan", "1");
+				owrt_ap_set_radio(dut, radio_id[1], "no_vlan", "1");
+			}
+
+			owrt_ap_set_vap(dut, radio_id[0], "MapBSSType", "32");
+			owrt_ap_set_vap(dut, radio_id[1], "MapBSSType", "32");
+#ifdef CONFIG_BUILD_YOCTO
+			owrt_ap_set_vap(dut, radio_id[0], "network", "DEFAULT_BRIDGE");
+			owrt_ap_set_vap(dut, radio_id[1], "network", "DEFAULT_BRIDGE");
+			run_system_wrapper(dut,
+			    "uci set wireless.qcawifi=qcawifi");
+			run_system_wrapper(dut,
+			    "uci set wireless.qcawifi.force_hostapd_attach=1");
+#endif
+			run_system_wrapper(dut, "uci commit wireless");
+
+			/* Set ezmesh Parameters */
+			run_system_wrapper(dut, "uci set ezmesh.config.Enable=1");
+			run_system_wrapper(dut, "uci set ezmesh.config.Mode=HYROUTER");
+			run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.MapPFCompliant=1");
+
+			if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE) {
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.EnableMapV2=0");
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.MapVersion=1");
+			} else {
+				if (dut->program == PROGRAM_MAPR2)
+					run_system_wrapper(dut,
+						"uci set ezmesh.MultiAP.MapVersion=2");
+				else if (dut->program == PROGRAM_MAPR3)
+					run_system_wrapper(dut,
+						"uci set ezmesh.MultiAP.MapVersion=3");
+				else if (dut->program == PROGRAM_MAPR4)
+					run_system_wrapper(dut,
+						"uci set ezmesh.MultiAP.MapVersion=4");
+								else
+					run_system_wrapper(dut,
+						"uci set ezmesh.MultiAP.MapVersion=5");
+
+#ifdef CONFIG_BUILD_YOCTO
+			if (dut->program == PROGRAM_MAPR2 || dut->program == PROGRAM_MAPR3 ||
+				dut->program == PROGRAM_MAPR4 || dut->program == PROGRAM_MAPR5) {
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.VlanNetworkPrimary="DEFAULT_BRIDGE);
+			}
+#endif
+								run_system_wrapper(dut,
+										"uci set ezmesh.MAPQoSMSettings.EnableMSCS=0");
+								run_system_wrapper(dut,
+										"uci set ezmesh.MAPQoSMSettings.EnableSCS=0");
+								run_system_wrapper(dut,
+										"uci set ezmesh.MAPQoSMSettings.EnableQosMap=0");
+								run_system_wrapper(dut,
+										"uci set ezmesh.MAPQoSMSettings.EnableDscpPolicy=0");
+
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.EnableBootOnlyScan=0");
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.EnableAgent=1");
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.ChanScanIntervalMin=5");
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.MapR1R2MixNotSupported=1");
+				run_system_wrapper(dut,
+					"uci set ezmesh.MultiAP.EnableMapV2=1");
+			}
+
+			run_system_wrapper(dut,
+				   "uci set ezmesh.MultiAP.EnableController=1");
+			run_system_wrapper(dut,
+				   "uci set ezmesh.DataElements.EnableDataElements=1");
+			run_system_wrapper(dut, "uci set ezmesh.MultiAP.EnableSigmaDUT=1");
+			run_system_wrapper(dut, "uci set "
+					"ezmesh.IEEE1905Settings."
+					"StrictIEEE1905Mode=1");
+			run_system_wrapper(dut, "uci set "
+					"ezmesh.Topology.ENABLE_NOTIFICATION_"
+					"UNICAST=1");
+			run_system_wrapper(dut, "uci set "
+					"ezmesh.Topology.PERIODIC_QUERY_"
+					"INTERVAL=15");
+			run_system_wrapper(dut, "uci commit ezmesh");
+
+			/* Set WSPLCD Parameters */
+			run_system_wrapper(dut,
+				   "uci set wsplcd.config.RunMode=REGISTRAR");
+			run_system_wrapper(dut, "uci set wsplcd.config.HyFiSecurity=1");
+			run_system_wrapper(dut, "uci set wsplcd.config.DeepClone=0");
+			run_system_wrapper(dut, "uci set wsplcd.config.ConfigSta=0");
+			run_system_wrapper(dut, "uci set "
+					"wsplcd.config.WriteDebugLogToFile="
+					"TRUNCATE");
+
+
+			if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE) {
+				run_system_wrapper(dut, "uci set wsplcd.config.MapEnable=1");
+				run_system_wrapper(dut, "uci set wsplcd.config.MapMaxBss=2");
+			} else {
+				run_system_wrapper(dut, "uci set wsplcd.config.MapEnable=2");
+				run_system_wrapper(dut, "uci set wsplcd.config.MapMaxBss=4");
+			}
+
+			run_system_wrapper(dut,
+				   "uci set wsplcd.config.MapPFCompliant=1");
+			run_system_wrapper(dut, "uci set wsplcd.config.ManageVAPInd=0");
+			run_system_wrapper(dut, "uci commit wsplcd");
+
+			/* Set EZLBD Parameters */
+			run_system_wrapper(dut, "uci set ezlbd.StaDB.TrackRemoteAssoc=1");
+			run_system_wrapper(dut, "uci set "
+					"ezlbd.Estimator_Adv."
+					"EnableContinuousThroughput=1");
+			run_system_wrapper(dut, "uci commit ezlbd");
+
+			run_system_wrapper(dut, "uci set mcsd.config.Enable=0");
+			run_system_wrapper(dut, "uci commit mcsd");
+
+			run_system_wrapper(dut, INIT_SCRIPT_PATH"mcsd stop");
+			run_system_wrapper(dut, INIT_SCRIPT_PATH"mcsd disable");
+			run_system_wrapper(dut, INIT_SCRIPT_PATH"hyfi-bridging start");
+
+			/* set repacd Parameters */
+			run_system_wrapper(dut,"uci set repacd.repacd.Enable=1");
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.Enable=1");
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.EnableLiteMode=1");
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.MapDeviceMode=CAP");
+			run_system_wrapper(dut,"uci set repacd.MAPConfig.MapDevResetDefault=1");
+
+			if (dut->program == PROGRAM_MAP || dut->program == PROGRAM_DE)
+				run_system_wrapper(dut,
+					"uci set repacd.MAPConfig.MapVersionEnabled=1");
