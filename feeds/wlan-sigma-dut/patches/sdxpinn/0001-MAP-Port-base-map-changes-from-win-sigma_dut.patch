+static int map_set_wifi_macaddr(struct sigma_dut *dut,
+				char **mac_addrval,
+								int radio_id[])
+{
+	unsigned char map_mac[ETH_ALEN];
+	char buf[512];
+	FILE *macaddr = NULL;
+	int j = 0;
+		int i = 0;
+		bool toConfigureRadio = false;
+
+	for (char **mac_addr_ptr = mac_addrval; mac_addr_ptr < (mac_addrval + MAX_RADIO); j++, mac_addr_ptr++) {
+			toConfigureRadio = false;
+			if ((*mac_addr_ptr)) {
+				if (parse_mac_address(dut, *mac_addr_ptr, map_mac) < 0) {
+						if (macaddr) {
+							pclose(macaddr);
+						}
+						return -1;
+				}
+
+				// Check if this radio has to be configured or skipped.
+				while(toConfigureRadio == false && j < MAX_RADIO) {
+					for(i = 0; i < num_radio; i++) {
+						if(radio_id[i] == j) {
+							toConfigureRadio = true;
+						}
+					}
+					// Skip the radio id which is not part of radio_id[]
+					// and increment j count
+					if(toConfigureRadio == false) {
+						j++;
+					}
+				}
+
+				snprintf(buf, sizeof(buf), "uci get wireless.%s%d.macaddr", "wifi", j);
+				macaddr = popen(buf, "r");
+				if (macaddr) {
+						fgets(buf, sizeof(buf), macaddr);
+						if (strncasecmp(buf, *mac_addr_ptr, 17) != 0 ) {
+								snprintf(buf, sizeof(buf),
+										"uci set wireless.%s%d.macaddr=%02x:%02x:%02x:%02x:%02x:%02x",
+										"wifi", j, map_mac[0], map_mac[1], map_mac[2], map_mac[3],
+													map_mac[4], map_mac[5]);
+								run_system_wrapper(dut, buf);
+						}
+				}
+			}
+	}
+
+	if (macaddr) {
+	    pclose(macaddr);
+		}
+	return 1;
+}
