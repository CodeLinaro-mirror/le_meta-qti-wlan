+	sigma_dut_reg_cmd("dev_start_buffer", NULL, cmd_dev_start_buffer);
+	sigma_dut_reg_cmd("dev_stop_buffer", NULL, cmd_dev_stop_buffer);
+	sigma_dut_reg_cmd("dev_set_trigger", NULL, cmd_dev_set_trigger);
+}
