+int hex_word(const char *str)
+{
+       return strtol(str, NULL, 0);
+}
+
+
+int decimal_byte(const char *str)
+{
+	return strtol(str, NULL, 10);
+}
+
+
+int binary_byte(const char *str)
+{
+	return strtol(str, NULL, 2);
+}
+
+
+int get_value(const char *str)
+{
+	const char *pr;
+	int value = -1;
+	pr  = str + 1;
+	if( *pr == 'x' )
+		value = hex_word(--pr);
+	else if (*pr == 'd')
+		value = decimal_byte(++pr);
+	else if (*pr == 'b')
+		value = binary_byte(++pr);
+
+	return value;
+}
