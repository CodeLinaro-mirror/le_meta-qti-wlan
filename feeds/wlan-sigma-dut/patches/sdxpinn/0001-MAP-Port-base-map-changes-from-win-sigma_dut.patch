+static int map_test_socket(struct sigma_dut *dut, struct sigma_conn *conn,
+			   char *map_tlvtype, char *map_alid,
+			   char *map_msgtypeval, char *map_tlvlength,
+			   char *map_tlvvalue)
+{
+	struct timeval tv;
+	int sock, rx_sock, cnt = 0;
+	char tx_buffer[MAP_MAX_PAYLOAD_SIZE] = {};
+	struct apac_map_sock_tlv *tx_message =
+	    (struct apac_map_sock_tlv *)tx_buffer;
+	u_int32_t temp;
+	struct sockaddr_un serveraddr = {AF_UNIX, MAP_SERVER_SOCKET};
+	char rx_buffer[MAP_MAX_SEND_DATA_SIZE] = {};
+	struct apac_map_sock_send_data *rx_message =
+	    (struct apac_map_sock_send_data *)rx_buffer;
+	int32_t rx_pathlen;
+	struct sockaddr_un clientaddr = {AF_UNIX, MAP_CLIENT_SOCKET};
+
+	/**tx: Create socket on which to send. */
+	sock = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (sock < 0) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode,MAP failed to create tx socket");
+		goto map_socket_out;
+	}
+	/**rx: Create socket on which to receive. */
+	rx_sock = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (rx_sock < 0) {
+		close(sock);
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode,MAP failed to create rx socket");
+		goto map_socket_out;
+	}
+
+	/**rx: Construct name of rx socket to receive to. */
+	memset(&clientaddr, 0, sizeof(clientaddr));
+	clientaddr.sun_family = AF_UNIX;
+	strlcpy(clientaddr.sun_path, MAP_CLIENT_SOCKET,
+		sizeof(clientaddr.sun_path));
+
+	rx_pathlen = strlen(MAP_CLIENT_SOCKET);
+	clientaddr.sun_path[rx_pathlen] = '\0';
+	unlink(clientaddr.sun_path);
+
+	/**rx: set timeout option to 25 seconds */
+
+	tv.tv_sec = 25; // 25 Secs Timeout
+	tv.tv_usec = 0; // Not init'ing this can cause strange errors
+	if (setsockopt(rx_sock, SOL_SOCKET, SO_RCVTIMEO, (const char *)&tv,
+		       sizeof(struct timeval)) < 0) {
+		close(rx_sock);
+		close(sock);
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode,MAP failed to set sockopt");
+		goto map_socket_out;
+	}
+	/**rx: Bind the UNIX domain address to the created socket */
+	if (bind(rx_sock, (const struct sockaddr *)(&clientaddr),
+		 sizeof(struct sockaddr_un)) < 0) {
+		close(rx_sock);
+		close(sock);
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"errorCode,MAP failed to bind");
+		goto map_socket_out;
+	}
+	/*tx: Prepare data to be transmitted */
+	memset(tx_buffer, 0, sizeof(tx_buffer));
+	temp = (uint8_t)strtol(map_tlvtype, NULL, 16);
+	tx_message->type = temp;
+	temp = (uint16_t)strtol(map_tlvlength, NULL, 16);
+	tx_message->len = temp;
+	temp = (uint16_t)strtol(map_msgtypeval, NULL, 16);
+	tx_message->msgtype = temp;
+	parse_mac_address(dut, map_alid, tx_message->alid);
+	memcpy(tx_message->content, (unsigned char *)map_tlvvalue,
+	       strlen(map_tlvvalue) + 1);
+
+	/**tx: Construct name of socket to send to. */
+	memset(&serveraddr, 0, sizeof(serveraddr));
+	serveraddr.sun_family = AF_UNIX;
+	strlcpy(serveraddr.sun_path, MAP_SERVER_SOCKET,
+		sizeof(serveraddr.sun_path));
+
+	/**tx: Send tx_message. */
+	sendto(sock, tx_buffer, sizeof(tx_buffer), 0,
+	       (const struct sockaddr *)&serveraddr,
+	       sizeof(struct sockaddr_un));
+
+	/*rx: Read from the socket - do as fast as possible to avoid racing
+	 * condition */
+	read(rx_sock, rx_buffer, sizeof(rx_buffer));
+	while ((rx_message->msgtype !=
+		(u_int32_t)strtol(dut->map_msgtypeval, NULL, 16)) &&
+	       cnt++ < 4) {
+		read(rx_sock, rx_buffer, sizeof(rx_buffer));
+	}
+
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+			"rx: retrye=%d",
+			cnt);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+			"rx: msgtype=%d",
+			rx_message->msgtype);
+	sigma_dut_print(dut, DUT_MSG_DEBUG,
+			"rx: mid=%d",
+			rx_message->mid);
+
+	map_send_data.msgtype = rx_message->msgtype;
+	map_send_data.mid = dut->map_mid = rx_message->mid;
+
+	close(rx_sock);
+	close(sock);
+
+	return 1;
+
+map_socket_out:
+	return -1;
+}
+
+
+static int map_parse_dpp_frame_info_file(struct sigma_dut *dut, struct sigma_conn * conn,
+				const char *message, const char *tlv, const char *mid, const char *filter,
+				const char *returncontent, char *resp, size_t resp_size)
+{
+	char *resp_messages[4] = {
+					"MessageTypePresent,",
+					"TLVList,",
+					"MessageDump,",
+					"TLVFieldValue,"
+				 };
+	char **pResp_messages = resp_messages;
+	char *pResp = resp;
+	char **tlv_list = (char**)malloc(MAP_TLV_ARRAY_SIZE*sizeof(char*));
+	char str[1024];
+	char *tlv_list_in_file, *mid_in_file, *savptr;
+	size_t new_resp_size = resp_size;
+	bool  exit_loop = false;
+	FILE *fp;
+	int j = 0;
+	int i = 0;
+
+	snprintf(pResp, new_resp_size, "%s", *pResp_messages);
+	pResp += strlen(*pResp_messages);
+	new_resp_size -= strlen(*pResp_messages);
+
+	if ((fp = fopen(DPP_GET_FRAME_INFO_TEMP_FILE, "r")) == NULL ||
+	     tlv_list == NULL)
+		goto map_parse_frame_nofile;
+
+	while (fgets(str, sizeof(str), fp) != NULL && !exit_loop) {
+	       if (strncasecmp (str, message, 6) == 0) {
+			tlv_list_in_file = strtok_r(str, ",", &savptr);  //noop
+			tlv_list_in_file = strtok_r(NULL, ",", &savptr);
+			mid_in_file = strtok_r(NULL, ",", &savptr);
+
+			if ((strncasecmp(mid, "NA", 2) == 0) ||
+			    (mid_in_file && strtol(mid, NULL, 0) == strtol(mid_in_file, NULL, 0))) {
+				tlv_list[j] = (char *)malloc((MAP_TLV_STRING_LEN+1)*sizeof(char));
+				if (tlv_list_in_file)
+					strlcpy(tlv_list[j], tlv_list_in_file, MAP_TLV_STRING_LEN);
+				//printf("\nstr1=%s\n", tlv_list[j]);
+				j++;
+				if (j == MAP_TLV_ARRAY_SIZE) {
+					j = 0;
+					exit_loop = true;
+				}
+			}
+		}
+	}
+
+map_parse_frame_nofile:
+
+	if (j == 0) {
+		snprintf(pResp, new_resp_size, "%s", "No");
+	} else {
+		snprintf(pResp, new_resp_size, "%s", "Yes,");
+		pResp += 4;
+		new_resp_size -= 4;printf("\nj=%d\n", j);
+
+		if (strncasecmp(returncontent, "TLV", 3) == 0 ) {
+			snprintf(pResp, new_resp_size, "%s%s%s", *(pResp_messages + 1),
+				"1_", tlv_list[j - 1]);
+
+		} else if (strncasecmp(returncontent, "MessageDump", 11) == 0) {
+			snprintf(pResp, new_resp_size, "%s", *(pResp_messages + 2));
+
+		} else {
+			snprintf(pResp, new_resp_size, "%s", *(pResp_messages + 3));
+
+		}
+	}
+
+	for (i = 0; i < j; i++) {
+		free(tlv_list[i]);
+	}
+
+	if (tlv_list)
+		free(tlv_list);
+
+	if (fp)
+		fclose(fp);
+
+	return 1;
+}
