+static int cmd_dev_get_frame_info(struct sigma_dut *dut, struct sigma_conn *conn,
+				  struct sigma_cmd *cmd)
+{
+#if defined(__linux__)
+	char resp[512] = {0};
+	const char *message = get_param(cmd, "message");
+	const char *tlv = get_param(cmd, "TLV");
+	const char *mid = get_param(cmd, "MID");
+	const char *filter = get_param(cmd, "filter");
+	const char *returncontent = get_param(cmd, "returncontent");
+	//const char *val = NULL;
+
+	if (tlv) {
+		goto map_get_frame_info_unsup;
+	}
+
+	if (!message || !mid || !filter || !returncontent) {
+		send_resp(dut, conn, SIGMA_ERROR,
+			"ErrorCode, parameter not specified");
+		return 0;
+	}
+
+	/* send message */
+	if (map_send_dpp_get_frame_info(dut, conn, message) < 0) {
+		send_resp(dut, conn, SIGMA_ERROR,
+			  "ErrorCode,send data failed");
+		return 0;
+	}
+
+	/* parse file */
+	if (map_parse_dpp_frame_info_file(dut, conn, message, tlv, mid, filter,
+					  returncontent, resp, sizeof(resp)) < 0) {
+		send_resp(dut, conn, SIGMA_ERROR,
+			  "ErrorCode,parse data failed");
+		return 0;
+	}
+
+	/* send response */
+	send_resp(dut, conn, SIGMA_COMPLETE, resp);
+	return 0;
+
+map_get_frame_info_unsup:
+	send_resp(dut, conn, SIGMA_ERROR,
+		"ErrorCode,Unsupported parameter");
+	return 0;
+
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		"errorCode,dev_get_frame_info not supported");
+	return -1;
+#endif /* __linux__ */
+
+}
