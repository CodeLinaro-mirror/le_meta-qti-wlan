+static int map_ap_autoconfiguration_renew_message(struct sigma_dut *dut)
+{
+	char *filename, *saveptr;
+	char buf[128];
+	char *pmid;
+	FILE *file;
+
+	run_system_wrapper(dut, INIT_SCRIPT_PATH"wsplcd restart");
+	sleep(5);
+
+	if (dut->map_supported_freq_band == MAP_FREQ_BAND_802_11_2_4GHZ)
+		filename = AUTO_RENEW_MID_TEMP_FILE;
+	else
+		filename = AUTO_RENEW_MID_5G_TEMP_FILE;
+
+	file = fopen(filename, "r");
+	if (!file)
+		return -1;
+
+	if (fgets(buf, sizeof(buf), file) == NULL)
+		buf[0] = '\0';
+	fclose(file);
+
+	pmid = strtok_r(buf, " ", &saveptr);
+	if (pmid == NULL)
+		return -1;
+
+	dut->map_mid = get_value(pmid);
+
+	unlink(filename);
+
+	if (dut->map_supported_freq_band == MAP_FREQ_BAND_802_11_2_4GHZ)
+		filename = AUTO_RENEW_MID_5G_TEMP_FILE;
+	else
+		filename = AUTO_RENEW_MID_TEMP_FILE;
+
+	unlink(filename);
+
+	return 1;
+}
