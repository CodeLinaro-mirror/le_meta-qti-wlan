+static bool map_is_wlanif_onboard(struct sigma_dut *dut, const char *ifname,
+				  const char *ssid)
+{
+	char line1[3][512];
+	char cmdline[64];
+	char *token;
+	char *saveptr;
+	int i;
+	regex_t re;
+	FILE *file;
+
+	cmdline[0] = '\0';
+
+	snprintf(cmdline, sizeof(cmdline), "iwconfig %s", ifname);
+
+	file = popen(cmdline, "r");
+	if (!file)
+		return false;
+
+	for (i = 0; i < 3; i++) {
+		if (fgets(line1[i], 512, file) == NULL) {
+			fclose(file);
+			return false;
+		}
+	}
+	pclose(file);
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: interface info: %s",
+			line1[0]);
+
+	if (regcomp(&re, ifname, REG_EXTENDED))
+		return false;
+
+	if (regexec(&re, line1[0], (size_t)0, NULL, 0) == REG_NOMATCH) {
+		regfree(&re);
+		return false;
+	}
+	regfree(&re);
+
+	if (regcomp(&re, ssid, REG_EXTENDED))
+		return false;
+
+	if (regexec(&re, line1[0], (size_t)0, NULL, 0) == 0) {
+		regfree(&re);
+		return false;
+	}
+	regfree(&re);
+
+	if (strtok_r(line1[2], " ", &saveptr) == NULL)
+		return false;
+
+	if ((token = strtok_r(NULL, " ", &saveptr)) == NULL)
+		return false;
+
+	token[3] = '0';
+	token[4] = 'd';
+
+	sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: bit rate: %d",
+			get_value(token + 3));
+
+	if (get_value(token + 3) <= 0)
+		return false;
+
+	return true;
+}
