+static int map_find_bssid(struct sigma_dut *dut, char *line1, bool *found,
+			  char *bssid)
+{
+	int rc = -1;
+	bool bailout = false;
+	char *token_p[512];
+	char *saveptr;
+	int p = 0;
+
+	token_p[p] = strtok_r(line1, " ", &saveptr);
+	if (token_p[p]) {
+		while (
+		    ((token_p[++p] = strtok_r(NULL, " ", &saveptr)) != NULL) &&
+		    (bailout == false)) {
+			if (strcmp(token_p[p], "Point:") == 0) {
+				bailout = true;
+				token_p[++p] = strtok_r(NULL, " ", &saveptr);
+				if (token_p[p]) {
+					rc = 1;
+					*found = true;
+					strlcpy(bssid, token_p[p],
+						strlen(token_p[p]) + 1);
+				}
+			}
+		}
+	}
+
+	if (rc < 0)
+		sigma_dut_print(dut, DUT_MSG_INFO, "MAP: bssid not found");
+	return rc;
+}
