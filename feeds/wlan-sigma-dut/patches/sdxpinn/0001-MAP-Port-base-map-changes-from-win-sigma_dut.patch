+
+	file = popen("iwconfig", "r");
+	if (!file)
+		goto map_get_bssid_ifname_out;
+
+	while ((fgets(line1, sizeof(line1), file) != NULL) && !found) {
+		token_p = strtok_r(line1, " ", &saveptr);
