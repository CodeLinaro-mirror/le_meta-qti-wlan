+static int map_parse_metric_reporting_policy_tlv(struct sigma_dut *dut,
+						 const char *mod, char *buf,
+						 size_t bufsize)
+{
+	/* tlvtype = 0x8A */
+	unsigned char map_ruid[6];
+	char token[4096], *token_p, *saveptr;
+	int i, k; /* for loop k */
+	int value;
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	dut->map_pw = buf;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0x8A;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* STA Metrics Reporting Interval in seconds  */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* BTM Steering Disallowed STA Count k  */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)k);
+	dut->map_pw += 3;
+
+	/* loop kNULL */
+	for (i = 0; i < k; i++) {
+		/* RUID */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_ruid) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x%02x%02x%02x%02x%02x ",
+			 map_ruid[0], map_ruid[1], map_ruid[2], map_ruid[3],
+			 map_ruid[4], map_ruid[5]);
+		dut->map_pw += 13;
+
+		/* STA Metric RSSI Reporting Threshold  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+
+		/* STA Metrics Reporting RSSI Hysteresis Margin Override */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+
+		/* AP Metrics Channel Utilization Reporting Threshold  */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+
+		/* bit 7: Associated STA Traffic Stats Inclussion Policy 0=no,
+		 * 1=yes */
+		/* bit 6: Associated STA Link Metrics Inclusion Policy 0=no,
+		 * 1=yes   */
+		/* bit 5-0: Reserved. */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+		dut->map_pw += 3;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
