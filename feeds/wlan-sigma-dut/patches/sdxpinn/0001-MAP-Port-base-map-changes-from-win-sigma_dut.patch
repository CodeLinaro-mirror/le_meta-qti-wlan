+	case IEEE1905_TLV_TYPE_CLIENT_INFO:
+		if (strlen(mod) >= sizeof(token)) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"MAP: parsing 1905_tlv"
