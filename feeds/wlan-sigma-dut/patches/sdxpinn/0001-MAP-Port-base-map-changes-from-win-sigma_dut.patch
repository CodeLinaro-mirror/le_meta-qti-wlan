+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
+
+static int map_parse_traffic_separation_policy_tlv(struct sigma_dut *dut,
+						   const char *mod, char *buf,
+						   size_t bufsize, int *vlan_id)
+{
+	/* tlvtype = 0xB6 */
+	char token[4096], *token_p, *saveptr;
+	int value, i, k, n;
+	dut->map_pw = buf;
+
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0xB6;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)value);
+	dut->map_pw += 3;
+
+	/* Number of SSIDs - k */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((k = get_value(token_p)) < 0)
+		return -1;
+	snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)k);
+	dut->map_pw += 3;
+
+	for (i = 0; i < k; i++) {
+		/* Length of SSID - n */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((n = get_value(token_p)) < 0)
+			return -1;
+		snprintf(dut->map_pw, bufsize, "%02x ", (unsigned char)n);
+		dut->map_pw += 3;
+
+		if (n < 1)
+			return -1;
+
+		/* SSID */
+		if (n > 0) {
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if ((!token_p) || (n != strlen(token_p)) ||
+			    (n > (bufsize - strlen(token_p))))
+				return -1;
+
+			strlcpy(dut->map_pw, token_p, n + 1);
+
+			dut->map_pw[n] = 0x20; /* space */
+			dut->map_pw += (n + 1);
+		}
+
+		/* Primary VLAN ID */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((value = get_value(token_p)) < 0)
+			return -1;
+		if (value < 0x0003 || value > 0x0FFE)
+			return -1;
+
+		*vlan_id = value; /* aev r2 */
+
+		snprintf(dut->map_pw, bufsize, "%04x ", (unsigned char)value);
+		dut->map_pw += 5;
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
