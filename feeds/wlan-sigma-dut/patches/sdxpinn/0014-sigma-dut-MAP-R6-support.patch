+			snprintf(dut->map_msgtypeval, sizeof(dut->map_msgtypeval), "0x%04x",
+			 IEEE1905_MSG_TYPE_BSTA_MLD_CONFIG_REQ);
+		}
+
+		else {
+			sigma_dut_print(dut, DUT_MSG_ERROR, "Unknown type %s",
+				val);
+			goto map_send_1905_error;
+		}
+
+		sigma_dut_print(dut, DUT_MSG_DEBUG, "MAP: msgtypevalue: %s",
+				dut->map_msgtypeval);
+
+		map_msgtypeval_i = get_value(dut->map_msgtypeval);
+
+		switch (map_msgtypeval_i) {
+
+		case IEEE1905_MSG_TYPE_AP_MLD_CONFIG_REQ:
+		case IEEE1905_MSG_TYPE_BSTA_MLD_CONFIG_REQ:
+
+			snprintf(buf, sizeof(buf), "%02x%02x%02x%02x%02x%02x",
+				 map_addr[0], map_addr[1], map_addr[2],
+				 map_addr[3], map_addr[4], map_addr[5]);
+			strlcpy(dut->map_alid, buf, sizeof(dut->map_alid));
+			if (map_test_socket(dut, conn, map_tlvtype,
+					    dut->map_alid, dut->map_msgtypeval,
+					    map_tlvlength,
+					    dut->map_tlvvalue) < 0) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,MAP socket failure");
+				goto map_send_1905_error;
+			}
+			snprintf(resp, sizeof(resp), "MID,0x%02x",
+				 dut->map_mid);
+			send_resp(dut, conn, SIGMA_COMPLETE, resp);
+			goto map_send_1905_ok;
+
+			break;
+
+		default:
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Message Type Value "
+				  "not supported");
+			goto map_send_1905_error;
+		}
+	}
+
+	send_resp(dut, conn, SIGMA_ERROR, "errorCode,dev_1905_reconfig invalid ");
+
+map_send_1905_error:
+	dut->map_pw = NULL;
+	return -1;
+
+map_send_1905_ok:
+	dut->map_pw = NULL;
+	return 0;
+#else  /* __linux__ */
+	send_resp(dut, conn, SIGMA_ERROR,
+		  "errorCode,dev_send_1905 not supported");
+	return -1;
+#endif /* __linux__ */
+}
