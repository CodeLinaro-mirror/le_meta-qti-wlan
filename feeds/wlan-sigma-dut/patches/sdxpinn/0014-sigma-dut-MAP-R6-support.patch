+static int map_parse_eht_operations_tlv(struct sigma_dut *dut, const char *mod,
+				     char *buf, size_t bufsize)
+{
+	/* tlvtype = 0xE7 */
+	char token[4096], *token_p, *saveptr;
+	unsigned char map_ruid[6];
+	//unsigned char map_bssid[6];
+	int value, r, i, b, j, k;
+	char *pw = buf;
+
+	memset(buf, 0, bufsize);
+	if (strlen(mod) >= sizeof(token))
+		return -1;
+	strlcpy(token, mod, sizeof(token));
+
+	value = 0x01;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	value = 0xE7;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* Reserved */
+	token_p = strtok_r(token, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((value = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+	pw += 3;
+
+	/* Reserved */
+	for (k = 0; k < 31; k++) {
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+				return -1;
+		if ((value = get_value(token_p)) < 0)
+				return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+		pw += 3;
+	}
+
+	/* Number of radios */
+	token_p = strtok_r(NULL, " ", &saveptr);
+	if (!token_p)
+		return -1;
+	if ((r = get_value(token_p)) < 0)
+		return -1;
+	snprintf(pw, bufsize, "%02x ", (unsigned char)r);
+	pw += 3;
+
+	for (i = 0; i < r; i++) {
+		/* RUID */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if (parse_mac_address(dut, token_p, map_ruid) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x%02x%02x%02x%02x%02x ", map_ruid[0],
+			 map_ruid[1], map_ruid[2], map_ruid[3], map_ruid[4],
+			 map_ruid[5]);
+		pw += 13;
+
+		/* Number of bss */
+		token_p = strtok_r(NULL, " ", &saveptr);
+		if (!token_p)
+			return -1;
+		if ((b = get_value(token_p)) < 0)
+			return -1;
+		snprintf(pw, bufsize, "%02x ", (unsigned char)b);
+		pw += 3;
+
+		for (j = 0; j < b; j++) {
+			/* BSSID Field */
+			for (k = 0; k < 6; k++) {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				if (!token_p)
+						return -1;
+				if ((value = get_value(token_p)) < 0)
+						return -1;
+				snprintf(pw, bufsize, "%02x", (unsigned char)value);
+				pw += 2;
+			}
+
+			snprintf(pw, bufsize, "%s", " ");
+			pw += 1;
+
+			/* Flags */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+			/* Basic EHT-MCS And Nss Set - 4 octets */
+			for (k = 0; k < 4; k++) {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				if (!token_p)
+						return -1;
+				if ((value = get_value(token_p)) < 0)
+						return -1;
+				snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+				pw += 3;
+			}
+
+			/* Control */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+			/* CCFS0 */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+			/* CCFS1 */
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+				return -1;
+			if ((value = get_value(token_p)) < 0)
+				return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+
+			/* Disabled_Subchannel_Bitmap - 2 octets */
+			for (k = 0; k < 2; k++) {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				if (!token_p)
+						return -1;
+				if ((value = get_value(token_p)) < 0)
+						return -1;
+				snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+				pw += 3;
+			}
+
+			/* Reserved */
+			for (k = 0; k < 16; k++) {
+				token_p = strtok_r(NULL, " ", &saveptr);
+				if (!token_p)
+						return -1;
+				if ((value = get_value(token_p)) < 0)
+						return -1;
+				snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+				pw += 3;
+			}
+		}
+		/* Reserved */
+		for (k = 0; k < 25; k++) {
+			token_p = strtok_r(NULL, " ", &saveptr);
+			if (!token_p)
+					return -1;
+			if ((value = get_value(token_p)) < 0)
+					return -1;
+			snprintf(pw, bufsize, "%02x ", (unsigned char)value);
+			pw += 3;
+		}
+	}
+
+	/* Done */
+	return (strtok_r(NULL, " ", &saveptr) ? -1 : 1);
+}
