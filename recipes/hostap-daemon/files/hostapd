# This file is used to config hostapd log relative configuration on OpenWRT,
# such as log level, folder to store and so on.

# The section hostapd is used to set hostapd-daemon's log print level and
# where to print.
# The 'log_folder_mode' option is used to set log where to print or store.
# 0 = syslog, the log will print in system log, need use "logread -f >
# /data/vendor/wifi/logread.txt" command to catch.
# 1 = /data/vendor/wifi/ folder.
# The 'log_level' option is used to set the log level to print, we support
# {debug, info} currently, debug is the default level, if set the level to
# info, few of log will print.

config hostapd 'log'
	option log_folder_mode '0'
	option log_level 'debug'

