-			len = WPA_GET_BE16(&buf[1]) - ETH_ALEN ;
+		if (WPA_GET_BE16(&buf[1]) > ETH_ALEN*2)
+			len = WPA_GET_BE16(&buf[1]) - ETH_ALEN*2 ;
 		else {
 			wpa_printf(MSG_ERROR, "nl80211: eapol packet len is insufficent ");
 			return;
 		}
 
-		if ( len && ((len + ETH_ALEN + 3) <= res)) {
+		if ( len && ((len + ETH_ALEN*2 + 3) <= res)) {
 			msg = os_malloc(len);
 			if (msg) {
-				os_memcpy(msg, buf+9, len);
-				wpa_sm_rx_eapol(wpa->supp, wpa->auth_addr, (u8 *) msg, len);
+				os_memcpy(msg, buf+15, len);
+				wpa_sm_rx_eapol(wpa->supp, wpa->auth_addr, (u8 *) msg, len, FRAME_ENCRYPTION_UNKNOWN);
 				wpa_printf(MSG_ERROR, "wpa_sm_rx_eapol done ");
 				os_free(msg);
 			}
