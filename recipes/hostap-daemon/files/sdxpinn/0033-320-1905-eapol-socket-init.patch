Subject: [PATCH 33/41] 320-1905-eapol-socket-init

Change-Id: Iea4feb940984006294ae82f9c28712199b52c05d
Signed-off-by: Chenming Huang <quic_chenhuan@quicinc.com>
---
 src/drivers/eap1905.c     | 55 +++++++++++++++++++++++++++++----------
 src/drivers/eap1905_sta.c | 55 ++++++++++++++++++++++++++++-----------
 2 files changed, 81 insertions(+), 29 deletions(-)

diff --git a/src/drivers/eap1905.c b/src/drivers/eap1905.c
index 859b97d7e6..4e3158dc7e 100644
--- a/src/drivers/eap1905.c
+++ b/src/drivers/eap1905.c
@@ -73,6 +73,7 @@ enum events {
 
 int eapol_1905_sock = -1;
 int eapol_1905_sock_tx = -1;
+int eapol_1905_create_tx_sock();
 
 static struct wpa_1905 wpa;
 struct wpa_auth_config conf;
@@ -331,6 +332,10 @@ static void eapol_1905_rx_receive(int sock, void *eloop_ctx, void *sock_ctx)
 			wpa_deinit(wpa->auth_group);
 
 		ap_init(wpa, (struct sec_config *) &buf[1]);
+		if ((eapol_1905_sock_tx < 0) && (eapol_1905_create_tx_sock() < 0)) {
+			wpa_printf(MSG_INFO, "nl80211: Could not register tx socket for 1905 eapol");
+			return;
+		}
 	} else if (buf[0] == EVENT_GROUP_KEY) {
 		if (wpa->auth_group)
 			wpa_auth_reconfig_group_keys(wpa->auth_group);
@@ -342,6 +347,37 @@ static void eapol_1905_rx_receive(int sock, void *eloop_ctx, void *sock_ctx)
 	}
 }
 
+int eapol_1905_create_tx_sock() {
+	struct sockaddr_in address;
+	int i = 0;
+
+	memset((char *)&address, 0, sizeof(address));
+	address.sin_family = AF_INET;
+	address.sin_addr.s_addr = htonl((127 << 24) | 1);
+
+	eapol_1905_sock_tx = socket(AF_INET, SOCK_DGRAM, 0);
+	if (eapol_1905_sock_tx < 0) {
+	    wpa_printf(MSG_ERROR, "nl80211: socket(PF_PACKET, SOCK_DGRAM, 1905 ETH_P_PAE) failed: %s",
+	    strerror(errno));
+	    return -1 ;
+	}
+	address.sin_port = htons(TX_PORT);
+
+	while (i <= 550) {
+		if (connect(eapol_1905_sock_tx, (struct sockaddr *)&address, sizeof(address)) < 0) {
+		    os_sleep(0, 100000);
+		    i++;
+		    continue;
+		}
+		return 0;
+	}
+
+	wpa_printf(MSG_ERROR, " connect failed :%s ", strerror(errno));
+	close(eapol_1905_sock_tx);
+	eapol_1905_sock_tx = -1;
+	return -1;
+}
+
 int eapol_1905_init()
 {
 	struct sockaddr_in address;
@@ -365,20 +401,6 @@ int eapol_1905_init()
 		return -1;
 	}
 
-	eapol_1905_sock_tx = socket(AF_INET, SOCK_DGRAM, 0);
-	if (eapol_1905_sock_tx < 0) {
-		wpa_printf(MSG_ERROR, "nl80211: socket(PF_PACKET, SOCK_DGRAM, 1905 ETH_P_PAE) failed: %s",
-			   strerror(errno));
-		return -1 ;
-	}
-	address.sin_port = htons(TX_PORT);
-
-	if (connect(eapol_1905_sock_tx, (struct sockaddr *)&address, sizeof(address)) < 0) {
-		wpa_printf(MSG_ERROR, " connect failed :%s ", strerror(errno));
-		close(eapol_1905_sock_tx);
-		return -1;
-	}
-
 	os_memset(&wpa, 0, sizeof(wpa));
 	if (eloop_register_read_sock(eapol_1905_sock, eapol_1905_rx_receive, &wpa, NULL)) {
 		close(eapol_1905_sock);
@@ -386,6 +408,11 @@ int eapol_1905_init()
 		return -1;
 	}
 
+	if (eapol_1905_create_tx_sock()) {
+		wpa_printf(MSG_INFO, "nl80211: Could not register tx socket for 1905 eapol");
+		return -1;
+	}
+
 	return 0;
 }
 
