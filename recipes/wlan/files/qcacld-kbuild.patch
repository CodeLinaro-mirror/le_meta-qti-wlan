From 9f0a3549baac3666ec4836801e73ac978b10d23a Mon Sep 17 00:00:00 2001
From: Yi Chen <quic_yichen@quicinc.com>
Date: Fri, 11 Feb 2022 11:33:23 +0800
Subject: [PATCH] WAR for include dir too long issue

Change-Id: Ic829e69be45932baedfd14db198a49c4a3d7ca59
Signed-off-by: Yi Chen <quic_yichen@quicinc.com>
---
 Kbuild | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/Kbuild b/Kbuild
index c430de49d6..c074d8cbc0 100644
--- a/Kbuild
+++ b/Kbuild
@@ -2292,11 +2292,35 @@ ifeq ($(CONFIG_WLAN_FEATURE_DP_RX_THREADS), y)
 OBJS += $(TXRX3.0_OBJS)
 endif
 
-ccflags-y += $(INCS)
+NEW_INCS= $(WLAN_ROOT)/all_headers/h1/h2/h3/h4
+
+
+$(shell mkdir -p $(NEW_INCS))
+$(foreach i,$(subst  -I, , $(INCS)), $(shell [ -d $(i) ] &&  cp -a $(i)/* $(NEW_INCS)))
+
+$(shell mkdir -p $(NEW_INCS)/../../core/src)
+$(shell mkdir -p $(NEW_INCS)/../../../../umac/wifi_pos/src)
+$(shell mkdir -p $(NEW_INCS)/../src)
+$(shell mkdir -p $(NEW_INCS)/../../../umac/cmn_services/utils/inc)
+$(shell mkdir -p $(NEW_INCS)/../../../nan/core/src/)
+$(shell mkdir -p $(NEW_INCS)/../dispatcher/inc)
+$(shell mkdir -p $(NEW_INCS)/../)
+
+$(shell cp -a $(WLAN_ROOT)/components/nan/core/src/*.h $(NEW_INCS)/../src)
+$(shell cp -a $(WLAN_ROOT)/components/tdls/core/src/*.h $(NEW_INCS)/../../core/src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/scan/core/src/*.h $(NEW_INCS)/../../core/src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/wifi_pos/src/*.h $(NEW_INCS)/../src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/mlme/vdev_mgr/core/src/*.h $(NEW_INCS)/../../core/src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/regulatory/core/src/*.h $(NEW_INCS)/../../core/src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/wifi_pos/src/*.h $(NEW_INCS)/../../../../umac/wifi_pos/src)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/cp_stats/core/src/*.h $(NEW_INCS)/../../core/src)
+$(shell cp -a $(WLAN_COMMON_INC)/spectral/core/*.h $(NEW_INCS)/../../core)
+$(shell cp -a $(WLAN_COMMON_INC)/umac/green_ap/core/src/*.h $(NEW_INCS)/../../core/src)
+
+ccflags-y += -Wimplicit-fallthrough=0 -I$(NEW_INCS)
 
 cppflags-y +=	-DANI_OS_TYPE_ANDROID=6 \
 		-Wall\
-		-Werror\
 		-D__linux__
 
 cppflags-$(CONFIG_PTT_SOCK_SVC_ENABLE) += -DPTT_SOCK_SVC_ENABLE
-- 
2.17.1

