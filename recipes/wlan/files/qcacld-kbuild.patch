From a75a716bec6ae0c93889d678530bc1de0ca0b2a0 Mon Sep 17 00:00:00 2001
From: Yi Chen <quic_yichen@quicinc.com>
Date: Fri, 7 Jul 2023 11:01:23 +0800
Subject: [PATCH] WAR for include dir too long issue

Change-Id: I16e2a6b846413c7121ab1b236cd8c3b6fd4ce122
Signed-off-by: Yi Chen <quic_yichen@quicinc.com>
---
 Kbuild   | 11 +++++++++--
 Makefile |  8 +++++---
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/Kbuild b/Kbuild
index ac1bffd86..af950991c 100644
--- a/Kbuild
+++ b/Kbuild
@@ -3028,7 +3028,6 @@ INCS +=		$(COAP_WMI_INC)
 ccflags-y += $(INCS)
 
 cppflags-y +=	-Wall\
-		-Werror
 
 cppflags-$(CONFIG_THERMAL_STATS_SUPPORT) += -DTHERMAL_STATS_SUPPORT
 cppflags-$(CONFIG_PTT_SOCK_SVC_ENABLE) += -DPTT_SOCK_SVC_ENABLE
@@ -4342,7 +4341,10 @@ ifeq ($(CONFIG_FEATURE_COEX_TPUT_SHAPING_ENABLE), y)
 cppflags-y += -DFEATURE_COEX_TPUT_SHAPING_CONFIG
 endif
 
-KBUILD_CPPFLAGS += $(cppflags-y)
+inc_file := wlan_cppflags_opts
+inc_var := $(shell echo $(cppflags-y) > $(inc_file))
+var := "@$(inc_file)"
+KBUILD_CPPFLAGS += $(var)
 
 # Currently, for versions of gcc which support it, the kernel Makefile
 # is disabling the maybe-uninitialized warning.  Re-enable it for the
@@ -4414,6 +4416,11 @@ ifneq ($(WLAN_CTRL_NAME),)
 ccflags-y += -DWLAN_CTRL_NAME=\"$(WLAN_CTRL_NAME)\"
 endif
 
+ccflags_file := wlan_ccflags_opts
+ccflags_var := $(shell echo $(ccflags-y) > $(ccflags_file))
+ccvar := "@$(ccflags_file)"
+ccflags-y := $(ccvar)
+
 # inject some build related information
 ifeq ($(CONFIG_BUILD_TAG), y)
 CLD_CHECKOUT = $(shell cd "$(WLAN_ROOT)" && \
diff --git a/Makefile b/Makefile
index 1e04c13d2..8923a6dac 100644
--- a/Makefile
+++ b/Makefile
@@ -31,10 +31,13 @@ KBUILD_OPTIONS += $(KBUILD_EXTRA) # Extra config if any
 endif
 
 all:
-	$(MAKE) -C $(KERNEL_SRC) M=$(M) modules $(KBUILD_OPTIONS)
+	$(shell [ ! -e $(KERNEL_SRC)/../qcacld ] && ln -s $(shell pwd) $(KERNEL_SRC)/../qcacld)
+	$(MAKE) -C $(KERNEL_SRC) M="../qcacld" modules $(KBUILD_OPTIONS)
+
+
 
 modules_install:
-	$(MAKE) INSTALL_MOD_STRIP=1 M=$(M) -C $(KERNEL_SRC) modules_install
+	$(MAKE) INSTALL_MOD_STRIP=1 M="../qcacld" -C $(KERNEL_SRC) modules_install
 
 clean:
-	$(MAKE) -C $(KERNEL_SRC) M=$(M) clean $(KBUILD_OPTIONS)
+	$(MAKE) -C $(KERNEL_SRC) M="../qcacld" clean $(KBUILD_OPTIONS)
