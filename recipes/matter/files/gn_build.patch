Subject: [PATCH] add gn build for matter

enable gn-native during matter build

Signed-off-by: Yingqian Yang <quic_yingqian@quicinc.com>
---
 build/gen.py | 1 -
 1 file changed, 1 deletion(-)

diff --git a/build/gen.py b/build/gen.py
index 2d109ed6..e84fc9a1 100755
--- a/build/gen.py
+++ b/build/gen.py
@@ -445,7 +445,6 @@ def WriteGNNinja(path, platform, host, options, args_list):
         '-Wextra',
         '-Wno-unused-parameter',

-        '-Wextra-semi',
         '-Wundef',

         '-std=c++17'
