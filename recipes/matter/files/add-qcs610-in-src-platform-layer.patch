+bool SendBLEIndication(uint16_t conId, const uint8_t *svcId, const uint8_t *charId, uint8_t *buf, uint16_t len)
+{
+    bool status = false;
+    string deviceAddress;
+    if (mgattServer) {
+        for (auto it= connectedDeviceMap.begin(); it != connectedDeviceMap.end(); ++it) {
+            if (it->second == conId) {
+                deviceAddress = it->first;
+                status = true;
+                break;
+            }
+        }
+        if (status) {
+            Uuid srvcUuid = Uuid::From128BitBE(svcId);
+            GattService* srv = mgattServer->getService(srvcUuid);
+            status = false;
+            if (srv) {
+                Uuid charUuid = Uuid::From128BitBE(charId);
+                GattCharacteristic *chr = srv->getCharacteristic(charUuid);
+                if (chr) {
+                    chr->setValue(buf, len);
+                    status = mgattServer->notifyCharacteristicChanged(deviceAddress, *chr, true);
+                }
+                else {
+                    ALOGD(LOGTAG"Characteristic UUID:%s is not found\n", charUuid.ToString().c_str());
+                }
+            }
+            else {
+                ALOGD(LOGTAG"Service UUID:%s is not found\n", srvcUuid.ToString().c_str());
+            }
+        }
+
+    }
+    ALOGD(LOGTAG"%s: %d\n", __func__, status);
+    return status;
+}
