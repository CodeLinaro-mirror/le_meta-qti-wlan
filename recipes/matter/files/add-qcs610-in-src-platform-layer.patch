+void BtMainMsgHandler (void *context) {
+    BtEvent *event = NULL;
+    if (!context) {
+        ALOGI (LOGTAG " Msg is null, return.\n");
+        return;
+    }
+    event = (BtEvent *) context;
+
+    ALOGI (LOGTAG " %s: event_id: %d.\n", __func__,  event->event_id);
+    switch (event->event_id) {
+        case MAIN_API_INIT:
+        {
+            InitHandler();
+            break;
+        }
+        case MAIN_API_DEINIT:
+        {
+            DeInitHandler();
+            break;
+        }
+        case MAIN_EVENT_ENABLED:
+        {
+            bt_state = event->state_event.status;
+            if (event->state_event.status == BT_STATE_OFF) {
+                ALOGD(LOGTAG " Error in Enabling BT\n");
+            } else {
+              ALOGD (LOGTAG " BT State is ON : %d",event->state_event.status);
+              g_adapter = new AdapterMain(g_gatt);
+              if (g_adapter != NULL) {
+                  g_adapter->AddMatterService();
+                  chip::DeviceLayer::Internal::BLEManagerImpl::NotifyBLEPeripheralAdvConfiguredComplete(true, nullptr);
+              }
+            }
+            break;
+        }
+
+        case MAIN_EVENT_DISABLED:
+        {
+            bt_state = event->state_event.status;
+            if (event->state_event.status == BT_STATE_ON) {
+                ALOGD(LOGTAG " Error in Disabling BT\n");
+            } else {
+                // clear the inquiry related cmds
+                // clearing bond_devices list and inquiry_list
+                connectedDeviceMap.clear();
+                system("killall -KILL wcnssfilter");
+                usleep(200);
+                ALOGD (LOGTAG " BT State is OFF : %d",bt_state);
+            }
+            ALOGD (LOGTAG " MAIN_EVENT_DISABLED");
+        }
+        break;
+        default:
+            break;
+    }
+}
+
+void BtSdpClientMsgHandler(void *context)
+{
+    BtEvent *event = NULL;
+    if (!context) {
+        ALOGI (LOGTAG " Msg is null, return.\n");
+        return;
+    }
+    event = (BtEvent *) context;
+
+    ALOGI (LOGTAG " %s: event_id: %d.\n", __func__,  event->event_id);
+    switch (event->event_id) {
+        case PROFILE_API_START:
+        {
+            uint8_t status = true;
+            if ((sdp_client_interface = (btsdp_interface_t *)
+                       bt_interface->get_profile_interface(BT_PROFILE_SDP_CLIENT_ID)) != NULL) {
+                sdp_client_interface->init(NULL);
+            }
+            else
+            {
+                ALOGE(LOGTAG "%s: Failed to get Bluetooth Sdp Client Interface", __FUNCTION__);
+            }
+
+            BtEvent *start_event = new BtEvent;
+            start_event->profile_start_event.event_id = PROFILE_EVENT_START_DONE;
+            start_event->profile_start_event.profile_id = PROFILE_ID_SDP_CLIENT;
+            start_event->profile_start_event.status = status;
+            PostMessage(THREAD_ID_GAP, start_event);
+            break;
+        }
+        case PROFILE_API_STOP:
+        {
+            uint8_t status = true;
+            if (sdp_client_interface) {
+                status = sdp_client_interface->deinit();
+            }
+            BtEvent *stop_event = new BtEvent;
+            stop_event->profile_start_event.event_id = PROFILE_EVENT_STOP_DONE;
+            stop_event->profile_start_event.profile_id = PROFILE_ID_SDP_CLIENT;
+            stop_event->profile_start_event.status = true;
+            PostMessage(THREAD_ID_GAP, stop_event);
+            break;
+        }
+        default:
+            break;
+    }
+}
