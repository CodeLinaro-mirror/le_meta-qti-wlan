diff --git a/src/ap/dpp_hostapd.c b/src/ap/dpp_hostapd.c
index 93f5e0e0ff..31059664a7 100644
--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -3378,11 +3378,12 @@ int hostapd_dpp_map_bss_conf_resp(struct hostapd_data *hapd, const char *cmd)
 int hostapd_dpp_configurator_sign(struct hostapd_data *hapd, const char *cmd)
 {
 	struct dpp_authentication *auth;
+	struct dpp_global *dpp = hapd->iface->interfaces->dpp;
 	int ret = -1;
 	char *curve = NULL;
 	char *map_netaccess_jwk = NULL;
 
-	auth = dpp_alloc_auth(hapd->iface->interfaces->dpp, hapd->msg_ctx);
+	auth = dpp_alloc_auth(dpp, hapd->msg_ctx);
 	if (!auth)
 		return -1;
 
@@ -3409,6 +3410,11 @@ int hostapd_dpp_configurator_sign(struct hostapd_data *hapd, const char *cmd)
 				auth->dpp_1905_connector);
 		}
 
+#ifdef CONFIG_DPP2
+               if(auth->conf_ap->netrole == DPP_NETROLE_MAP_CONTROLLER) {
+                       dpp_set_controller(dpp);
+               }
+#endif
 		ret = 0;
 	}
 
@@ -4174,6 +4180,19 @@ hostapd_dpp_map_peer_disc_auth(struct dpp_global *dpp, void *ctx)
 
 	return auth;
 }
+
+int hostapd_check_dpp_controller(struct hostapd_data *hapd, const char *uri, const u8* addr)
+{
+       if(dpp_check_controller(hapd->iface->interfaces->dpp)) {
+               wpa_printf(MSG_DEBUG, "DPP: Not controller, Forwarding the DPP URI"
+                               "to ezmesh to forward it to the controller\n");
+               wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_URI_NOTIFY "dst=" MACSTR
+                               " src=" MACSTR " uri=%s", MAC2STR(hapd->own_addr), MAC2STR(addr), uri);
+               return -1;
+       }
+       return 0;
+}
+
 #endif /* CONFIG_DPP2 */
 
 
