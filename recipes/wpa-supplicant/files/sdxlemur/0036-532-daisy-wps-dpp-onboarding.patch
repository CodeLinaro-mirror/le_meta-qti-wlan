+static void gas_comeback_req_wait(void *eloop_ctx, void *timeout_ctx)
+{
+        struct hostapd_data *hapd = eloop_ctx;
+        struct dpp_authentication *auth = hapd->dpp_auth;
+	struct gas_dialog_info *dialog;
+        if(!auth)
+                return;
