 #ifdef CONFIG_DPP2
-static int hostapd_wps_dpp_uri_cb(void *ctx, const char *uri)
+static int hostapd_wps_dpp_uri_cb(void *ctx, const char *uri, const u8* addr)
 {
 	struct hostapd_data *hapd = ctx;
 
+       /*In easymesh if this is not controller forward the dpp uri to easymesh as event*/
+       if(hapd->conf->dpp_map) {
+               if(hostapd_check_dpp_controller(hapd, uri, addr)) {
+                       return 0;
+               }
+       }
+
 	return hostapd_dpp_qr_code(hapd, uri);
 }
 #endif
