From 1d6476362420a2401de18cb8c35796f7b45fdf3a Mon Sep 17 00:00:00 2001
From: Xinyue Ling <xinyling@qti.qualcomm.com>
Date: Tue, 30 Apr 2024 14:50:18 +0800
Subject: [PATCH 24/40] 309-dpp-increase-auth-confirm-timeout

Change-Id: I1eea8df35b24a1b9920ec9a6cf5ad97abade57df
Signed-off-by: Chenming Huang <chenhuan@qti.qualcomm.com>
---
 src/ap/dpp_hostapd.c            | 2 +-
 wpa_supplicant/dpp_supplicant.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/ap/dpp_hostapd.c b/src/ap/dpp_hostapd.c
index 9ad28923a9..1fd3c9a3ca 100644
--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -630,7 +630,7 @@ void hostapd_dpp_tx_status(struct hostapd_data *hapd, const u8 *dst,
 		 * allow new authentication exchanges to be started. */
 		eloop_cancel_timeout(hostapd_dpp_auth_conf_wait_timeout, hapd,
 				     NULL);
-		eloop_register_timeout(1, 0, hostapd_dpp_auth_conf_wait_timeout,
+		eloop_register_timeout(2, 0, hostapd_dpp_auth_conf_wait_timeout,
 				       hapd, NULL);
 	}
 
diff --git a/wpa_supplicant/dpp_supplicant.c b/wpa_supplicant/dpp_supplicant.c
index 18d0d2b5ff..bc1328afda 100644
--- a/wpa_supplicant/dpp_supplicant.c
+++ b/wpa_supplicant/dpp_supplicant.c
@@ -597,7 +597,7 @@ static void wpas_dpp_tx_status(struct wpa_supplicant *wpa_s,
 		 * allow new authentication exchanges to be started. */
 		eloop_cancel_timeout(wpas_dpp_auth_conf_wait_timeout, wpa_s,
 				     NULL);
-		eloop_register_timeout(1, 0, wpas_dpp_auth_conf_wait_timeout,
+		eloop_register_timeout(2, 0, wpas_dpp_auth_conf_wait_timeout,
 				       wpa_s, NULL);
 	}
 
-- 
