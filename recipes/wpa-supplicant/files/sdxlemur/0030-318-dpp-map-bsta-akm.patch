From d8df7185f45d0b009a0d0f7a7ccb35643f79b9e4 Mon Sep 17 00:00:00 2001
From: Xinyue Ling <xinyling@qti.qualcomm.com>
Date: Tue, 30 Apr 2024 15:01:14 +0800
Subject: [PATCH 30/40] 318-dpp-map-bsta-akm

Change-Id: I9ee09edee6ea504b62a0bc8bb2c0657c518b5d74
Signed-off-by: Chenming Huang <chenhuan@qti.qualcomm.com>
---
 src/common/dpp.c | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/common/dpp.c b/src/common/dpp.c
index 6ddf81554f..5bf64d950d 100644
--- a/src/common/dpp.c
+++ b/src/common/dpp.c
@@ -1029,12 +1029,21 @@ struct wpabuf * dpp_build_conf_req_helper(struct dpp_authentication *auth,
 
 	/* Add bSTA List */
 	if(dpp_map && auth) {
+		const char *akm_str = "";
+
+		if (auth->akm_1905) {
+			akm_str = dpp_akm_str(auth->akm_1905);
+			wpa_printf(MSG_INFO, "bsta_akm: %s\n", akm_str);
+		}
 		json_value_sep(json);
 		json_start_array(json, "bSTAList");
 		wpabuf_put_u8(json, '{');
 		json_add_string(json, "netRole", dpp_netrole_str(DPP_NETROLE_MAP_BACKHAUL_STA));
 		json_value_sep(json);
-		json_add_string(json, "akm", "dpp+psk+sae");
+		if (auth->akm_1905)
+			json_add_string(json, "akm", akm_str);
+		else
+			json_add_string(json, "akm", "dpp+psk+sae"); //bsta_akm
 		json_value_sep(json);
 		json_add_string(json, "channelList", "81/1,115/36");
 		wpabuf_put_u8(json, '}');
@@ -1378,6 +1387,9 @@ static int dpp_configuration_parse_helper(struct dpp_authentication *auth,
 			auth->conf_ap = conf_ap;
 		else
 			auth->conf2_ap = conf_ap;
+		if (conf_sta != NULL)
+			auth->akm_1905 = conf_sta->akm;
+		wpa_printf(MSG_INFO, "bsta_akm is %d\n", auth->akm_1905);
 	} else {
 		goto fail;
 	}
@@ -2691,8 +2703,11 @@ cont:
 			if (token->type == JSON_STRING) {
 				wpa_printf(MSG_DEBUG, "DPP: 1905 akm = '%s'",
 					   token->string);
-				auth->akm_1905 =
-						dpp_akm_from_str(token->string);
+				if (!auth->akm_1905) {
+					auth->akm_1905 =
+							dpp_akm_from_str(token->string); //bsta_akm
+					wpa_printf(MSG_DEBUG, "bsta_akm from conf req is %d\n", auth->akm_1905);
+				}
 				wpa_printf(MSG_DEBUG,
 					   "DPP: 1905 bSTA AKM : %d",
 					   auth->akm_1905);
-- 
