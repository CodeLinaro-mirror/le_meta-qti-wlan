@@ -5532,6 +5546,50 @@ void dpp_notify_auth_success(struct dpp_authentication *auth, int initiator)
 }
 
 
+int dpp_map_bss_conf_resp(struct dpp_authentication *auth, const char *cmd)
+{
+	char *curve = NULL;
+	char *confobj = NULL;
+	size_t confobjlen = 0;
+	int ret = -1;
+
+	curve = get_param(cmd, " curve=");
+	confobj = get_confobj(cmd, " confobj=");
+
+	if (confobj)
+		confobjlen = os_strlen(confobj);
+
+	else
+		goto fail;
+
+	auth->curve = dpp_get_curve_name(curve);
+	if (!auth->curve) {
+		wpa_printf(MSG_INFO, "DPP: Unsupported curve: %s", curve);
+		goto fail;
+	}
+
+	auth->own_protocol_key = dpp_gen_keypair(auth->curve);
+	if (!auth->own_protocol_key)
+		goto fail;
+
+	if (!auth->num_conf_obj)
+		auth->num_conf_obj = 0;
+	auth->peer_version = 2;
+	auth->map_bss_conf_resp = 1;
+	if (dpp_parse_conf_obj(auth, (u8 *) confobj, confobjlen) < 0) {
+                wpa_printf(MSG_DEBUG, "DPP : failed parsing configurationObject JSON");
+		goto fail;
+        }
+
+	auth->map_bss_conf_resp = 0;
+	ret = 0;
+fail:
+	os_free(curve);
+	if (confobj)
+		os_free(confobj);
+	return ret;
+}
