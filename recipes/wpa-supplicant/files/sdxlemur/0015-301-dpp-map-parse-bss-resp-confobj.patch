+	if (auth->map_bss_conf_resp) {
+		token = json_get_member(discovery, "RUID");
+		if (!token || token->type != JSON_STRING) {
+			dpp_auth_fail(auth, "No RUID value found");
+			goto fail;
+		}
+	}
+
+	if (auth->map_bss_conf_resp) {
