From fb6788f0026d8b50e01d61d3060d9fdf80d0ff1b Mon Sep 17 00:00:00 2001
From: Xinyue Ling <quic_xinyling@quicinc.com>
Date: Tue, 30 Apr 2024 15:06:43 +0800
Subject: [PATCH 36/41] 322-dpp-nullcheck-auth-protocol-keys

Change-Id: I005e78a212beb055d242a53e83f3225b01a1a639
Signed-off-by: Chenming Huang <quic_chenhuan@quicinc.com>
---
 src/common/dpp_crypto.c         | 18 ++++++++++++------
 wpa_supplicant/wps_supplicant.c |  1 +
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/common/dpp_crypto.c b/src/common/dpp_crypto.c
index f17f95a2ca..7dfe6288dc 100644
--- a/src/common/dpp_crypto.c
+++ b/src/common/dpp_crypto.c
@@ -980,8 +980,10 @@ int dpp_gen_i_auth(struct dpp_authentication *auth, u8 *i_auth)
 	nonce_len = auth->curve->nonce_len;
 
 	if (auth->initiator) {
-		pix = crypto_ec_key_get_pubkey_point(auth->own_protocol_key, 0);
-		prx = crypto_ec_key_get_pubkey_point(auth->peer_protocol_key,
+		if (auth->own_protocol_key)
+			pix = crypto_ec_key_get_pubkey_point(auth->own_protocol_key, 0);
+		if (auth->peer_protocol_key)
+			prx = crypto_ec_key_get_pubkey_point(auth->peer_protocol_key,
 						     0);
 		if (auth->own_bi)
 			bix = crypto_ec_key_get_pubkey_point(
@@ -990,11 +992,14 @@ int dpp_gen_i_auth(struct dpp_authentication *auth, u8 *i_auth)
 			bix = NULL;
 		if (!auth->peer_bi)
 			goto fail;
-		brx = crypto_ec_key_get_pubkey_point(auth->peer_bi->pubkey, 0);
+		if (auth->peer_bi->pubkey)
+			brx = crypto_ec_key_get_pubkey_point(auth->peer_bi->pubkey, 0);
 	} else {
-		pix = crypto_ec_key_get_pubkey_point(auth->peer_protocol_key,
+		if (auth->peer_protocol_key)
+			pix = crypto_ec_key_get_pubkey_point(auth->peer_protocol_key,
 						     0);
-		prx = crypto_ec_key_get_pubkey_point(auth->own_protocol_key, 0);
+		if (auth->own_protocol_key)
+			prx = crypto_ec_key_get_pubkey_point(auth->own_protocol_key, 0);
 		if (auth->peer_bi)
 			bix = crypto_ec_key_get_pubkey_point(
 				auth->peer_bi->pubkey, 0);
@@ -1002,7 +1007,8 @@ int dpp_gen_i_auth(struct dpp_authentication *auth, u8 *i_auth)
 			bix = NULL;
 		if (!auth->own_bi)
 			goto fail;
-		brx = crypto_ec_key_get_pubkey_point(auth->own_bi->pubkey, 0);
+		if (auth->own_bi->pubkey)
+			brx = crypto_ec_key_get_pubkey_point(auth->own_bi->pubkey, 0);
 	}
 	if (!pix || !prx || !brx)
 		goto fail;
diff --git a/wpa_supplicant/wps_supplicant.c b/wpa_supplicant/wps_supplicant.c
index 054f334aa2..0c33e5d1ae 100644
--- a/wpa_supplicant/wps_supplicant.c
+++ b/wpa_supplicant/wps_supplicant.c
@@ -1818,6 +1818,7 @@ int wpas_wps_ssid_bss_match(struct wpa_supplicant *wpa_s,
 		}
 
 		if (wpa_s->wps && wpa_s->wps->dpp_wps) {
+		    if (dpp_bootstrap_get_uri(wpa_s->dpp, 1))
 			wpa_s->wps->wps_dpp_uri = os_strdup(dpp_bootstrap_get_uri(wpa_s->dpp, 1));
 		}
 #endif
-- 
