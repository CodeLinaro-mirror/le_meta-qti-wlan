@@ -225,6 +225,7 @@ struct wpa_sm {
 	int dpp_pfs;
 #endif /* CONFIG_DPP2 */
 	struct wpa_sm_mlo mlo;
+	u8 skip_validate_ie;
 
 	bool wmm_enabled;
 	bool driver_bss_selection;
